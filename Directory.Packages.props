<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Hosting and infrastructure">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.15" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Label="IPC, UI and CLI">
    <PackageVersion Include="StreamJsonRpc" Version="2.26.150" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="System.CommandLine" Version="2.0.15" />
  </ItemGroup>
  <!--
    Updating Avalonia: check that nothing HeapScope uses went paid (ADR-025), and whether it brings a new SkiaSharp. A new
    SkiaSharp needs HeapScope's own SkiaSharp native library rebuilt BY HAND before any package builds (ADR-038; rare):
    CI's "SkiaSharp native library" check fails with the steps, and DEVELOPER.md section 7 has them in full.
  -->
  <ItemGroup Label="Avalonia UI (ADR-025: MIT only; before any update, check that nothing used went paid)">
    <PackageVersion Include="Avalonia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <!-- The app's font (ADR-040). The package is MIT; the Inter typeface in it is OFL-1.1, allowed for fonts (DEVELOPER.md 4). -->
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.6" />
  </ItemGroup>
  <ItemGroup Label="Diagnostics">
    <PackageVersion Include="Microsoft.Diagnostics.Runtime" Version="4.2.751201" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.750501" />
    <PackageVersion Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.0" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
  </ItemGroup>
</Project>
