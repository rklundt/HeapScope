<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      No PlatformTarget (AnyCPU, sprint 2.3.6, ADR-025): every process runs as the machine's own 64-bit architecture, x64
      or arm64, and a published build takes its runtime identifier's. Until 2.3.5 everything was x64 (ADR-001).
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
    <Version>3.8.0</Version>
    <Product>HeapScope</Product>
    <Company>HeapScope</Company>
    <Copyright>Copyright (C) 2026 Ray Klundt</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <HeapScopeRoot>$(MSBuildThisFileDirectory)</HeapScopeRoot>
    <!-- Paths in the binaries are made repository-relative in CI and release builds (sprint 3.7, peer review P17). -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <!--
    Lock files (sprint 3.7, peer review P16): every project records the exact packages it restored, with their hashes, in
    packages.lock.json, and CI restores in locked mode, so a changed or substituted package fails the build instead of
    entering it. A publish for a runtime identifier restores runtime packs the lock files do not list, so it is not locked;
    file-based tools (build/*.cs) have no project file of their own and no lock file.
  -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/$(MSBuildProjectName).csproj')">
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true' and '$(RuntimeIdentifier)' == ''">true</RestoreLockedMode>
  </PropertyGroup>
</Project>
