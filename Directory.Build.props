<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      No PlatformTarget (AnyCPU, sprint 2.3.6, ADR-025): every process runs as the machine's own 64-bit architecture, x64
      or arm64, and a published build takes its runtime identifier's. Until 2.3.5 everything was x64 (ADR-001).
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
    <Version>3.5.0</Version>
    <Product>HeapScope</Product>
    <Company>HeapScope</Company>
    <Copyright>Copyright (C) 2026 Ray Klundt</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <HeapScopeRoot>$(MSBuildThisFileDirectory)</HeapScopeRoot>
  </PropertyGroup>
</Project>
