<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- x64, or arm64 when published for an arm64 runtime identifier (osx-arm64; sprint 2.3.6, ADR-025). -->
    <PlatformTarget Condition="$(RuntimeIdentifier.EndsWith('-arm64'))">arm64</PlatformTarget>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
    <Version>2.3.5</Version>
    <Product>HeapScope</Product>
    <Company>HeapScope</Company>
    <Copyright>Copyright (C) 2026 Ray Klundt</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <HeapScopeRoot>$(MSBuildThisFileDirectory)</HeapScopeRoot>
  </PropertyGroup>
</Project>
