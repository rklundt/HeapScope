<?xml version="1.0" encoding="utf-8"?>
<!--
  Packages come from nuget.org only (sprint 3.7, peer review P16): <clear /> drops any feed a machine's own NuGet
  configuration adds, and source mapping says where every package may come from, so a package of the same name on
  another feed can never be restored instead.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
