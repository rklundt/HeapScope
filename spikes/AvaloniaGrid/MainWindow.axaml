<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HeapScope.Spikes.AvaloniaGrid.MainWindow"
        Title="HeapScope (Avalonia prototype)" Width="1400" Height="820">
  <DockPanel Margin="10">
    <!-- The attribution strip (ADR-022) as the real app shows it: real text on a solid background. -->
    <Border DockPanel.Dock="Bottom" Background="#1F2937" Padding="8,4" Margin="0,8,0,0">
      <TextBlock Text="Powered by HeapScope by Ray Klundt" Foreground="White" />
    </Border>
    <TextBlock DockPanel.Dock="Top" x:Name="StatusText" Margin="0,0,0,6" TextWrapping="Wrap" />
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,6">
      <TextBox x:Name="FilterBox" Width="280" PlaceholderText="Filter types (StaticCacheEntry, SCE, Sys*Byte)" />
      <CheckBox x:Name="RetainedBox" Content="Retained sizes" />
      <TextBlock x:Name="TypesTotals" VerticalAlignment="Center" Opacity="0.7" />
    </StackPanel>
    <Grid ColumnDefinitions="*,10,*">
      <DataGrid x:Name="TypesGrid" Grid.Column="0" IsReadOnly="True" CanUserSortColumns="True" SelectionMode="Single"
                GridLinesVisibility="None" RowHeight="22" HeadersVisibility="Column">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" SortMemberPath="Name" />
          <DataGridTextColumn Header="Objects" Binding="{Binding Objects, StringFormat={}{0:N0}}" Width="100" SortMemberPath="Objects" />
          <DataGridTextColumn Header="Bytes" Binding="{Binding Bytes, StringFormat={}{0:N0}}" Width="130" SortMemberPath="Bytes" />
          <DataGridTextColumn Header="Retained" Binding="{Binding Retained, StringFormat={}{0:N0}}" Width="130" SortMemberPath="Retained" IsVisible="False" />
        </DataGrid.Columns>
      </DataGrid>
      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" x:Name="InstancesTitle" Text="Double-click a type to list its objects" Margin="0,0,0,4" FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top" x:Name="InstancesTotals" Margin="0,0,0,4" Opacity="0.7" />
        <DataGrid x:Name="InstancesGrid" IsReadOnly="True" CanUserSortColumns="True" SelectionMode="Single"
                  GridLinesVisibility="None" RowHeight="22" HeadersVisibility="Column">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Address" Binding="{Binding AddressText}" Width="150" SortMemberPath="Address" FontFamily="Consolas,Menlo,monospace" />
            <DataGridTextColumn Header="Bytes" Binding="{Binding Bytes, StringFormat={}{0:N0}}" Width="100" SortMemberPath="Bytes" />
            <DataGridTextColumn Header="Retained" Binding="{Binding Retained, StringFormat={}{0:N0}}" Width="110" SortMemberPath="Retained" IsVisible="False" />
            <DataGridTextColumn Header="Generation" Binding="{Binding Generation}" Width="100" SortMemberPath="Generation" />
            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" SortMemberPath="Value" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
