<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Sprint 2.3.5 prototype: the types grid and a type's objects in Avalonia, over the real snapshot session and the
    existing view models (linked from UI.Wpf, unchanged). Outside HeapScope.sln, never shipped; deleted once the port
    replaces it. Every package here is MIT (checked in the sprint; ADR-025's update rule applies).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>HeapScope.Spikes.AvaloniaGrid</RootNamespace>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- A throwaway prototype: warnings do not fail its build. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1031;CA1303;CA1515;CA2007;CA1812;CA1822;CA1848;CA5394;IDE0005;CS0618</NoWarn>
    <WarningsAsErrors />
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\HeapScope.Application\HeapScope.Application.csproj" />
    <ProjectReference Include="..\..\src\HeapScope.Contracts\HeapScope.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The WPF app's view models, linked unchanged: how much of today's UI code carries over is part of the question. -->
    <Compile Include="..\..\src\HeapScope.UI.Wpf\ViewModels\VirtualRowList.cs" Link="Linked\VirtualRowList.cs" />
    <Compile Include="..\..\src\HeapScope.UI.Wpf\ViewModels\GridQueryViewModel.cs" Link="Linked\GridQueryViewModel.cs" />
    <Compile Include="..\..\src\HeapScope.UI.Wpf\ViewModels\TypeGridViewModel.cs" Link="Linked\TypeGridViewModel.cs" />
    <Compile Include="..\..\src\HeapScope.UI.Wpf\ViewModels\TypeSummaryViewModel.cs" Link="Linked\TypeSummaryViewModel.cs" />
    <Compile Include="..\..\src\HeapScope.UI.Wpf\ViewModels\InstancesViewModel.cs" Link="Linked\InstancesViewModel.cs" />
  </ItemGroup>
  <Import Project="..\..\build\Worker.Deploy.targets" />
</Project>
