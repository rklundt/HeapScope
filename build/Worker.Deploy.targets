<Project>
  <!--
    Deploys HeapScope.Worker into a worker/ subfolder of the importing project's output.
    The reference is build-order only: no worker type is visible to the importing project (ARCHITECTURE.md 3.1).
  -->
  <PropertyGroup>
    <_HeapScopeWorkerProject>$(MSBuildThisFileDirectory)..\src\HeapScope.Worker\HeapScope.Worker.csproj</_HeapScopeWorkerProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(_HeapScopeWorkerProject)" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Target Name="HeapScopeDeployWorker" AfterTargets="Build">
    <MSBuild Projects="$(_HeapScopeWorkerProject)" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_HeapScopeWorkerTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <_HeapScopeWorkerDir>@(_HeapScopeWorkerTargetPath->'%(RootDir)%(Directory)')</_HeapScopeWorkerDir>
    </PropertyGroup>
    <ItemGroup>
      <_HeapScopeWorkerFiles Include="$(_HeapScopeWorkerDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_HeapScopeWorkerFiles)"
          DestinationFiles="@(_HeapScopeWorkerFiles->'$(OutDir)worker\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
  <!-- A published UI or CLI carries the worker the same way (built output of the worker, same configuration). -->
  <Target Name="HeapScopePublishWorker" AfterTargets="Publish" DependsOnTargets="HeapScopeDeployWorker" Condition="'$(RuntimeIdentifier)' == ''">
    <Copy SourceFiles="@(_HeapScopeWorkerFiles)"
          DestinationFiles="@(_HeapScopeWorkerFiles->'$(PublishDir)worker\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
  <!--
    Published for a runtime identifier (self-contained builds per system, sprint 2.3.6): the worker is published for the
    same identifier into the worker/ subfolder, self-contained like the app, since a framework-dependent worker would
    need an installed .NET runtime.
  -->
  <Target Name="HeapScopePublishWorkerForRuntime" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != ''">
    <MSBuild Projects="$(_HeapScopeWorkerProject)" Targets="Restore" Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);HeapScopeRestore=true" />
    <MSBuild Projects="$(_HeapScopeWorkerProject)" Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishReadyToRun=$(PublishReadyToRun);PublishDir=$(PublishDir)worker" />
  </Target>
</Project>
