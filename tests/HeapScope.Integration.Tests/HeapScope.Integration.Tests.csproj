<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\HeapScope.Application\HeapScope.Application.csproj" />
    <ProjectReference Include="..\..\src\HeapScope.Contracts\HeapScope.Contracts.csproj" />
    <ProjectReference Include="..\..\fixtures\Leaks\Leaks.csproj" />
    <!-- The loader and the index cache are tested in process against fixture dumps (sprint 1.2). -->
    <ProjectReference Include="..\..\src\HeapScope.Loaders.ClrMd\HeapScope.Loaders.ClrMd.csproj" />
    <ProjectReference Include="..\..\src\HeapScope.Loaders.GcDump\HeapScope.Loaders.GcDump.csproj" />
    <ProjectReference Include="..\..\src\HeapScope.Loaders.Trace\HeapScope.Loaders.Trace.csproj" />
    <ProjectReference Include="..\..\src\HeapScope.Storage\HeapScope.Storage.csproj" />
    <ProjectReference Include="..\..\src\HeapScope.Analysis\HeapScope.Analysis.csproj" />
    <!-- Build order only: the tests start these executables from their own output folders. -->
    <!-- Referenced (sprint 2.2) so the text tree of `paths` is tested directly; the tests still run the built exe. -->
    <ProjectReference Include="..\..\src\HeapScope.Cli\HeapScope.Cli.csproj" />
    <ProjectReference Include="..\..\src\HeapScope.UI\HeapScope.UI.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\fixtures\LeakyConsole\LeakyConsole.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\fixtures\LeakyApi\LeakyApi.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\fixtures\DenseHeap\DenseHeap.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\fixtures\LoadGen\LoadGen.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <!-- Known answers are verified with ClrMD directly until HeapScope's own loader exists (sprint 0.4 decision 6). -->
    <PackageReference Include="Microsoft.Diagnostics.Runtime" />
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" />
  </ItemGroup>
  <Import Project="$(HeapScopeRoot)build\Worker.Deploy.targets" />
</Project>
