<!-- HeapScope dark theme (sprint 1.3). Both themes define the same keys; a test checks it. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Brush.Window" Color="#FF1E1E1E" />
  <SolidColorBrush x:Key="Brush.Text" Color="#FFE6EDF3" />
  <SolidColorBrush x:Key="Brush.Subtle" Color="#FF9DA7B1" />
  <SolidColorBrush x:Key="Brush.Border" Color="#FF3D444D" />
  <SolidColorBrush x:Key="Brush.Surface" Color="#FF252526" />
  <SolidColorBrush x:Key="Brush.AltRow" Color="#FF2B2D30" />
  <SolidColorBrush x:Key="Brush.Selection" Color="#FF1F3A5F" />
  <SolidColorBrush x:Key="Brush.Note.Background" Color="#FF3B3220" />
  <SolidColorBrush x:Key="Brush.Note.Border" Color="#FF9E7B23" />
  <SolidColorBrush x:Key="Brush.Info.Background" Color="#FF1B2B3D" />
  <SolidColorBrush x:Key="Brush.Info.Border" Color="#FF388BFD" />
  <SolidColorBrush x:Key="Brush.Error.Background" Color="#FF3D1F1D" />
  <SolidColorBrush x:Key="Brush.Error.Border" Color="#FFF85149" />
  <SolidColorBrush x:Key="HeapKind.Unknown" Color="#FF757575" />
  <SolidColorBrush x:Key="HeapKind.Gen0" Color="#FF66BB6A" />
  <SolidColorBrush x:Key="HeapKind.Gen1" Color="#FF42A5F5" />
  <SolidColorBrush x:Key="HeapKind.Gen2" Color="#FF9575CD" />
  <SolidColorBrush x:Key="HeapKind.LargeObjectHeap" Color="#FFFFA726" />
  <SolidColorBrush x:Key="HeapKind.PinnedObjectHeap" Color="#FFF06292" />
  <SolidColorBrush x:Key="HeapKind.Frozen" Color="#FF90A4AE" />

  <!-- Implicit styles so standard controls follow the theme. -->
  <Style TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource Brush.Window}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="RowBackground" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="AlternatingRowBackground" Value="{DynamicResource Brush.AltRow}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Brush.Border}" />
  </Style>
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Subtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="0,0,1,1" />
    <Setter Property="Padding" Value="6,3" />
  </Style>
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
  </Style>
  <Style TargetType="StatusBar">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Subtle}" />
  </Style>
</ResourceDictionary>
