<!-- HeapScope light theme (sprint 1.3). Both themes define the same keys; a test checks it. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Brush.Window" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Brush.Text" Color="#FF1F2328" />
  <SolidColorBrush x:Key="Brush.Subtle" Color="#FF57606A" />
  <SolidColorBrush x:Key="Brush.Border" Color="#FFD0D7DE" />
  <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Brush.AltRow" Color="#FFF6F8FA" />
  <SolidColorBrush x:Key="Brush.Selection" Color="#FFDDF4FF" />
  <SolidColorBrush x:Key="Brush.Note.Background" Color="#FFFFF8C5" />
  <SolidColorBrush x:Key="Brush.Note.Border" Color="#FFD4A72C" />
  <SolidColorBrush x:Key="Brush.Info.Background" Color="#FFDDF4FF" />
  <SolidColorBrush x:Key="Brush.Info.Border" Color="#FF54AEFF" />
  <SolidColorBrush x:Key="Brush.Error.Background" Color="#FFFDECEA" />
  <SolidColorBrush x:Key="Brush.Error.Border" Color="#FFD93025" />
  <SolidColorBrush x:Key="HeapKind.Unknown" Color="#FF9E9E9E" />
  <SolidColorBrush x:Key="HeapKind.Gen0" Color="#FF4CAF50" />
  <SolidColorBrush x:Key="HeapKind.Gen1" Color="#FF2196F3" />
  <SolidColorBrush x:Key="HeapKind.Gen2" Color="#FF673AB7" />
  <SolidColorBrush x:Key="HeapKind.LargeObjectHeap" Color="#FFFF9800" />
  <SolidColorBrush x:Key="HeapKind.PinnedObjectHeap" Color="#FFE91E63" />
  <SolidColorBrush x:Key="HeapKind.Frozen" Color="#FF607D8B" />

  <!-- Implicit styles so standard controls follow the theme. -->
  <Style TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource Brush.Window}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="RowBackground" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="AlternatingRowBackground" Value="{DynamicResource Brush.AltRow}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Brush.Border}" />
  </Style>
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Subtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="0,0,1,1" />
    <Setter Property="Padding" Value="6,3" />
  </Style>
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
  </Style>
  <Style TargetType="StatusBar">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Subtle}" />
  </Style>
</ResourceDictionary>
