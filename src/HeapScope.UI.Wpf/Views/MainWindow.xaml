<Window x:Class="HeapScope.UI.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HeapScope.UI.Wpf.ViewModels"
        xmlns:ctl="clr-namespace:HeapScope.UI.Wpf.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="{Binding Title}"
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <ctl:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
    <ctl:ResourceKeyToBrushConverter x:Key="ResourceKeyToBrush" />
    <ctl:SameToVisibilityConverter x:Key="SameToVisibility" />

    <DataTemplate DataType="{x:Type vm:JobViewModel}">
      <Grid Margin="0,2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="280" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="240" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <ProgressBar Grid.Column="1" Height="14" Margin="8,0" Minimum="0" Maximum="100"
                     Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" />
        <TextBlock Grid.Column="2" Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="3" Content="Cancel" Padding="8,1" Command="{Binding CancelCommand}" />
      </Grid>
    </DataTemplate>

    <Style x:Key="NumberCell" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Margin" Value="4,0" />
    </Style>

    <Style x:Key="Tile" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="MinWidth" Value="130" />
    </Style>

    <DataTemplate DataType="{x:Type vm:SnapshotsViewModel}">
      <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
          <TextBlock FontSize="20" Text="Snapshots" VerticalAlignment="Center" />
          <Button Content="Open dump..." Margin="16,0,0,0" Padding="12,2" Command="{Binding OpenDumpCommand}" />
          <Button Content="Close" Margin="8,0,0,0" Padding="12,2" Command="{Binding CloseCommand}" CommandParameter="{Binding Selected}" />
          <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Text="{Binding Status}" TextWrapping="Wrap" MaxWidth="600" />
        </StackPanel>

        <ListBox DockPanel.Dock="Left" Width="260" Margin="0,0,16,0" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding Selected}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="2,4">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                <TextBlock Text="{Binding Process}" Foreground="{DynamicResource Brush.Subtle}" FontSize="11" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TabControl SelectedIndex="{Binding SelectedTab}">
          <TabItem Header="Snapshot">
            <Grid>
              <TextBlock Text="Open a full memory dump (.dmp) to see what is on the heap." Foreground="{DynamicResource Brush.Subtle}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Selected}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>

              <!-- Hidden, not collapsed, without a snapshot: it stays laid out, so its grids' templates are applied when the
                   page is built rather than when the first dump opens (sprint 1.5). -->
              <DockPanel DataContext="{Binding Selected}">
                <DockPanel.Style>
                  <Style TargetType="DockPanel">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Hidden" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DockPanel.Style>
                <StackPanel DockPanel.Dock="Top">
                  <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Process}" Foreground="{DynamicResource Brush.Subtle}" />
                  <TextBlock Text="{Binding Source}" Foreground="{DynamicResource Brush.Subtle}" Margin="0,0,0,8" />
                  <WrapPanel>
                    <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="Objects" Foreground="{DynamicResource Brush.Subtle}" FontSize="11" /><TextBlock Text="{Binding Objects}" FontSize="18" FontWeight="SemiBold" /></StackPanel></Border>
                    <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="Heap size" Foreground="{DynamicResource Brush.Subtle}" FontSize="11" /><TextBlock Text="{Binding Size}" FontSize="18" FontWeight="SemiBold" /></StackPanel></Border>
                    <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="Types" Foreground="{DynamicResource Brush.Subtle}" FontSize="11" /><TextBlock Text="{Binding Types}" FontSize="18" FontWeight="SemiBold" /></StackPanel></Border>
                    <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="References" Foreground="{DynamicResource Brush.Subtle}" FontSize="11" /><TextBlock Text="{Binding References}" FontSize="18" FontWeight="SemiBold" /></StackPanel></Border>
                    <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="Roots" Foreground="{DynamicResource Brush.Subtle}" FontSize="11" /><TextBlock Text="{Binding Roots}" FontSize="18" FontWeight="SemiBold" /></StackPanel></Border>
                  </WrapPanel>
                  <Border Background="{DynamicResource Brush.Note.Background}" BorderBrush="{DynamicResource Brush.Note.Border}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,8,8"
                          Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Notes}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                </StackPanel>

                <!-- Subjects (sprint 1.5): the types grid, a type's objects, one object; back and forward. -->
                <DockPanel DataContext="{Binding DataContext.Navigator, RelativeSource={RelativeSource AncestorType=TabControl}}">
                  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Back" Padding="8,1" Command="{Binding BackCommand}" ToolTip="Back (Alt+Left or the mouse's back button)" />
                    <Button Content="Forward" Padding="8,1" Margin="4,0,0,0" Command="{Binding ForwardCommand}" ToolTip="Forward (Alt+Right or the mouse's forward button)" />
                    <ItemsControl ItemsSource="{Binding Trail}" Margin="12,0,0,0" VerticalAlignment="Center">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text=" / " Foreground="{DynamicResource Brush.Subtle}" />
                            <TextBlock Text="{Binding Title}" MaxWidth="360" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <!-- One view per kind of subject, built at window load; the navigator swaps their data (sprint 1.5). -->
                  <Grid>
                    <Grid Visibility="{Binding IsTypesShown, Converter={StaticResource BoolToVisibility}}">
                      <DockPanel DataContext="{Binding Types}">
                        <DockPanel.Resources>
                          <ctl:BindingProxy x:Key="Types" Data="{Binding}" />
                        </DockPanel.Resources>

                        <!-- Heap kinds: one fixed color per kind, width by share of the bytes. -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,8,8">
                          <ItemsControl ItemsSource="{Binding HeapKinds}" Height="10">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <ctl:ProportionalPanel />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border ctl:ProportionalPanel.Weight="{Binding Fraction}" ToolTip="{Binding Text}"
                                        Background="{Binding BrushKey, Converter={StaticResource ResourceKeyToBrush}}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <ItemsControl ItemsSource="{Binding HeapKinds}" Margin="0,4,0,0">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                  <Border Width="10" Height="10" Margin="0,0,4,0" Background="{Binding BrushKey, Converter={StaticResource ResourceKeyToBrush}}" />
                                  <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{DynamicResource Brush.Subtle}" />
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>

                        <DockPanel DockPanel.Dock="Top" Margin="0,0,8,6">
                          <TextBlock DockPanel.Dock="Left" Text="Types" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                          <TextBlock DockPanel.Dock="Left" Text="Group by" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource Brush.Subtle}" />
                          <ComboBox DockPanel.Dock="Left" Width="110" ItemsSource="{Binding Groupings}" SelectedItem="{Binding GroupBy}" />
                          <TextBlock DockPanel.Dock="Left" Text="Filter" VerticalAlignment="Center" Margin="16,0,6,0" Foreground="{DynamicResource Brush.Subtle}" />
                          <TextBox DockPanel.Dock="Left" Width="260" VerticalContentAlignment="Center"
                                   Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                                   ToolTip="Substring; capitals match as typed or as CamelHumps (SCE finds StaticCacheEntry); * matches anything." />
                          <CheckBox DockPanel.Dock="Left" Content="Generations" Margin="16,0,0,0" VerticalAlignment="Center"
                                    IsChecked="{Binding ShowGenerations}" IsEnabled="{Binding HasGenerations}"
                                    ToolTip="Show bytes per generation (Gen0, Gen1, Gen2, LOH, POH, frozen) for every row." />
                          <TextBlock Text="{Binding Totals}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource Brush.Subtle}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Margin="0,0,0,4"
                                   Visibility="{Binding Status, Converter={StaticResource NotEmptyToVisibility}}" />
                        <TextBlock DockPanel.Dock="Top" Text="{Binding GenerationsExplanation}" Margin="0,0,0,4" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Subtle}"
                                   Visibility="{Binding GenerationsExplanation, Converter={StaticResource NotEmptyToVisibility}}" />

                        <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="None" RowHeight="22" CanUserSortColumns="True" SelectionMode="Single"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True"
                                  ctl:GridSorting.Command="{Binding SortByCommand}" ctl:GridSorting.State="{Binding SortState}"
                                  ctl:GridDrill.Command="{Binding OpenRowCommand}" ToolTip="Double-click or Enter opens a type's objects.">
                          <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Name" Width="*" SortMemberPath="Name">
                              <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                  <TextBlock Margin="4,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                             ctl:HighlightedText.Filter="{Binding Data.Filter, Source={StaticResource Types}}"
                                             ctl:HighlightedText.Text="{Binding Name}" />
                                </DataTemplate>
                              </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Objects" Binding="{Binding Objects, StringFormat=N0}" Width="100" SortMemberPath="Objects" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Bytes" Binding="{Binding Bytes, StringFormat=N0}" Width="130" SortMemberPath="Bytes" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="%" Binding="{Binding Percent, StringFormat=N2}" Width="60" CanUserSort="False" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Gen0" Binding="{Binding Gen0, StringFormat=N0}" Width="110" CanUserSort="False" ElementStyle="{StaticResource NumberCell}"
                                                Visibility="{Binding Data.GenerationColumnsShown, Source={StaticResource Types}, Converter={StaticResource BoolToVisibility}}" />
                            <DataGridTextColumn Header="Gen1" Binding="{Binding Gen1, StringFormat=N0}" Width="110" CanUserSort="False" ElementStyle="{StaticResource NumberCell}"
                                                Visibility="{Binding Data.GenerationColumnsShown, Source={StaticResource Types}, Converter={StaticResource BoolToVisibility}}" />
                            <DataGridTextColumn Header="Gen2" Binding="{Binding Gen2, StringFormat=N0}" Width="110" CanUserSort="False" ElementStyle="{StaticResource NumberCell}"
                                                Visibility="{Binding Data.GenerationColumnsShown, Source={StaticResource Types}, Converter={StaticResource BoolToVisibility}}" />
                            <DataGridTextColumn Header="LOH" Binding="{Binding LargeObjectHeap, StringFormat=N0}" Width="110" CanUserSort="False" ElementStyle="{StaticResource NumberCell}"
                                                Visibility="{Binding Data.GenerationColumnsShown, Source={StaticResource Types}, Converter={StaticResource BoolToVisibility}}" />
                            <DataGridTextColumn Header="POH" Binding="{Binding PinnedObjectHeap, StringFormat=N0}" Width="90" CanUserSort="False" ElementStyle="{StaticResource NumberCell}"
                                                Visibility="{Binding Data.GenerationColumnsShown, Source={StaticResource Types}, Converter={StaticResource BoolToVisibility}}" />
                            <DataGridTextColumn Header="Frozen" Binding="{Binding Frozen, StringFormat=N0}" Width="90" CanUserSort="False" ElementStyle="{StaticResource NumberCell}"
                                                Visibility="{Binding Data.GenerationColumnsShown, Source={StaticResource Types}, Converter={StaticResource BoolToVisibility}}" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </DockPanel>
    
                    </Grid>
                    <Grid Visibility="{Binding IsInstancesShown, Converter={StaticResource BoolToVisibility}}">
                      <DockPanel DataContext="{Binding ShownInstances}">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,8,6">
                          <TextBlock DockPanel.Dock="Left" Text="Filter" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource Brush.Subtle}" />
                          <TextBox DockPanel.Dock="Left" Width="260" VerticalContentAlignment="Center"
                                   Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                                   ToolTip="0x1f2a: address prefix. /pattern/: regular expression on the value. Anything else: text in the value (strings)." />
                          <TextBlock Text="{Binding Totals}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource Brush.Subtle}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Margin="0,0,0,4"
                                   Visibility="{Binding Status, Converter={StaticResource NotEmptyToVisibility}}" />
                        <TextBlock DockPanel.Dock="Top" Text="{Binding ValuesExplanation}" Margin="0,0,0,4" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Subtle}"
                                   Visibility="{Binding ValuesExplanation, Converter={StaticResource NotEmptyToVisibility}}" />
                        <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="None" RowHeight="22" CanUserSortColumns="True" SelectionMode="Single"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True"
                                  ctl:GridSorting.Command="{Binding SortByCommand}" ctl:GridSorting.State="{Binding SortState}"
                                  ctl:GridDrill.Command="{Binding OpenRowCommand}" ToolTip="Double-click or Enter opens an object.">
                          <DataGrid.Columns>
                            <DataGridTextColumn Header="Address" Binding="{Binding AddressText}" Width="150" SortMemberPath="Address" FontFamily="Consolas" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*" SortMemberPath="Type" />
                            <DataGridTextColumn Header="Bytes" Binding="{Binding Bytes, StringFormat=N0}" Width="110" SortMemberPath="Bytes" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Generation" Binding="{Binding Generation}" Width="120" SortMemberPath="Generation" />
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*" SortMemberPath="Value" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </DockPanel>
    
                    </Grid>
                    <Grid Visibility="{Binding IsObjectShown, Converter={StaticResource BoolToVisibility}}">
                      <DockPanel DataContext="{Binding ShownObject}">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Margin="0,0,0,4" TextWrapping="Wrap" />
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Margin="0,0,0,4"
                                   Visibility="{Binding Status, Converter={StaticResource NotEmptyToVisibility}}" />
                        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Info.Background}" BorderBrush="{DynamicResource Brush.Info.Border}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,8,6"
                                Visibility="{Binding FieldsUnavailable, Converter={StaticResource NotEmptyToVisibility}}">
                          <TextBlock Text="{Binding FieldsUnavailable}" TextWrapping="Wrap" />
                        </Border>
                        <TextBox DockPanel.Dock="Top" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120" Margin="0,0,8,6"
                                 VerticalScrollBarVisibility="Auto" Visibility="{Binding Text, Converter={StaticResource NotEmptyToVisibility}}" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Text="Fields" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TreeView ItemsSource="{Binding Fields}" BorderBrush="{DynamicResource Brush.Border}"
                                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                              <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                </Style>
                              </TreeView.ItemContainerStyle>
                              <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                  <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,8,0" />
                                    <TextBlock>
                                      <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                          <Setter Property="Visibility" Value="Collapsed" />
                                          <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLink}" Value="True">
                                              <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </TextBlock.Style>
                                      <Hyperlink Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=TreeView}}" CommandParameter="{Binding}"
                                                 ToolTip="Open this object">
                                        <Run Text="{Binding Value, Mode=OneWay}" />
                                      </Hyperlink>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Value}">
                                      <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                          <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLink}" Value="True">
                                              <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding TypeName}" Margin="8,0,0,0" FontSize="11" Foreground="{DynamicResource Brush.Subtle}" VerticalAlignment="Center" />
                                  </StackPanel>
                                </HierarchicalDataTemplate>
                              </TreeView.ItemTemplate>
                            </TreeView>
                          </DockPanel>
                          <DockPanel Grid.Column="2">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                              <TextBlock Text="References" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding ReferencesTotals}" Margin="12,0,0,0" Foreground="{DynamicResource Brush.Subtle}" />
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding ReferenceRows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                      GridLinesVisibility="None" RowHeight="22" CanUserSortColumns="False" SelectionMode="Single"
                                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True"
                                      ctl:GridDrill.Command="{Binding OpenCommand}" ToolTip="Double-click or Enter opens the referenced object.">
                              <DataGrid.Columns>
                                <DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="140" />
                                <DataGridTextColumn Header="Address" Binding="{Binding AddressText}" Width="140" FontFamily="Consolas" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*" />
                                <DataGridTextColumn Header="Bytes" Binding="{Binding Bytes, StringFormat=N0}" Width="90" ElementStyle="{StaticResource NumberCell}" />
                              </DataGrid.Columns>
                            </DataGrid>
                          </DockPanel>
                        </Grid>
                      </DockPanel>
    
                    </Grid>
                  </Grid>
                </DockPanel>
              </DockPanel>
            </Grid>
          </TabItem>

          <!-- Comparison of two open snapshots (sprint 1.4, ADR-018): per-type deltas, no object identity. -->
          <TabItem Header="Compare">
            <DockPanel DataContext="{Binding Compare}" Margin="0,8,0,0">
              <DockPanel.Resources>
                <ctl:BindingProxy x:Key="Compare" Data="{Binding}" />
                <Style x:Key="DeltaCell" TargetType="TextBlock" BasedOn="{StaticResource NumberCell}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Trend}" Value="1">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Growth}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Trend}" Value="-1">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Shrink}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DockPanel.Resources>

              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,8,8">
                <TextBlock Text="Baseline" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource Brush.Subtle}" />
                <ComboBox Width="260" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding Baseline}" DisplayMemberPath="Title" ToolTip="The earlier snapshot; deltas are current minus baseline." />
                <Button Content="Swap" Margin="8,0" Padding="10,1" Command="{Binding SwapCommand}" />
                <TextBlock Text="Current" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource Brush.Subtle}" />
                <ComboBox Width="260" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding Current}" DisplayMemberPath="Title" />
              </StackPanel>
              <TextBlock DockPanel.Dock="Top" Text="{Binding Hint}" Margin="0,0,0,6" Foreground="{DynamicResource Brush.Subtle}"
                         Visibility="{Binding Hint, Converter={StaticResource NotEmptyToVisibility}}" />

              <DockPanel DockPanel.Dock="Top" Margin="0,0,8,6">
                <TextBlock DockPanel.Dock="Left" Text="Group by" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource Brush.Subtle}" />
                <ComboBox DockPanel.Dock="Left" Width="110" ItemsSource="{Binding Groupings}" SelectedItem="{Binding GroupBy}" />
                <TextBlock DockPanel.Dock="Left" Text="Filter" VerticalAlignment="Center" Margin="16,0,6,0" Foreground="{DynamicResource Brush.Subtle}" />
                <TextBox DockPanel.Dock="Left" Width="260" VerticalContentAlignment="Center"
                         Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Substring; capitals match as typed or as CamelHumps (SCE finds StaticCacheEntry); * matches anything." />
                <TextBlock Text="{Binding Totals}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource Brush.Subtle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Totals}" />
              </DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Margin="0,0,0,4"
                         Visibility="{Binding Status, Converter={StaticResource NotEmptyToVisibility}}" />

              <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                        GridLinesVisibility="None" RowHeight="22" CanUserSortColumns="True" SelectionMode="Single"
                        EnableRowVirtualization="True" EnableColumnVirtualization="True"
                        VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                        ScrollViewer.CanContentScroll="True"
                        ctl:GridSorting.Command="{Binding SortByCommand}" ctl:GridSorting.State="{Binding SortState}"
                        ctl:GridDrill.Command="{Binding OpenRowCommand}" ToolTip="Double-click or Enter opens the type's objects in the current snapshot.">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="Name" Width="*" SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Margin="4,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                   ctl:HighlightedText.Filter="{Binding Data.Filter, Source={StaticResource Compare}}"
                                   ctl:HighlightedText.Text="{Binding Name}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="60" SortMemberPath="Change">
                    <DataGridTextColumn.HeaderStyle>
                      <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                        <Setter Property="ToolTip" Value="new: only in the current snapshot. gone: only in the baseline. copies: the same type is loaded a different number of times (see the Types columns), for example a plugin reloaded while its old copy stays alive." />
                      </Style>
                    </DataGridTextColumn.HeaderStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Objects +/-" Binding="{Binding ObjectsDelta, StringFormat=+#\,0;-#\,0;0}" Width="110" SortMemberPath="ObjectsDelta" ElementStyle="{StaticResource DeltaCell}" />
                  <DataGridTextColumn Header="Bytes +/-" Binding="{Binding BytesDelta, StringFormat=+#\,0;-#\,0;0}" Width="130" SortMemberPath="BytesDelta" ElementStyle="{StaticResource DeltaCell}" />
                  <DataGridTextColumn Header="Objects (baseline)" Binding="{Binding BaselineObjects, StringFormat=N0}" Width="120" SortMemberPath="BaselineObjects" ElementStyle="{StaticResource NumberCell}" />
                  <DataGridTextColumn Header="Objects (current)" Binding="{Binding CurrentObjects, StringFormat=N0}" Width="120" SortMemberPath="CurrentObjects" ElementStyle="{StaticResource NumberCell}" />
                  <DataGridTextColumn Header="Bytes (baseline)" Binding="{Binding BaselineBytes, StringFormat=N0}" Width="140" SortMemberPath="BaselineBytes" ElementStyle="{StaticResource NumberCell}" />
                  <DataGridTextColumn Header="Bytes (current)" Binding="{Binding CurrentBytes, StringFormat=N0}" Width="140" SortMemberPath="CurrentBytes" ElementStyle="{StaticResource NumberCell}" />
                  <DataGridTextColumn Header="Types (baseline)" Binding="{Binding BaselineTypes}" Width="100" SortMemberPath="BaselineTypes" ElementStyle="{StaticResource NumberCell}" />
                  <DataGridTextColumn Header="Types (current)" Binding="{Binding CurrentTypes}" Width="100" SortMemberPath="CurrentTypes" ElementStyle="{StaticResource NumberCell}" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>

          <!-- Inspections of the selected snapshot (sprint 1.6, ADR-020): tiles with finding, cause and fix, fragmentation
               bars, and the selected inspection's rows; double-click opens a row's objects on the Snapshot tab. -->
          <TabItem Header="Inspections">
            <DockPanel DataContext="{Binding Inspections}" Margin="0,8,0,0">
              <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Margin="0,0,0,6"
                         Visibility="{Binding Status, Converter={StaticResource NotEmptyToVisibility}}" />
              <ScrollViewer DockPanel.Dock="Left" Width="360" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                <StackPanel>
                  <ListBox ItemsSource="{Binding Tiles}" SelectedItem="{Binding Selected}" BorderThickness="0"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                      </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="4" Padding="10,6">
                          <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFindings}" Value="True">
                                      <Setter Property="Foreground" Value="{DynamicResource Brush.Growth}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                      <Setter Property="Foreground" Value="{DynamicResource Brush.Subtle}" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Brush.Subtle}"
                                       Visibility="{Binding Status, Converter={StaticResource NotEmptyToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding FirstRows}" Margin="0,2,0,0">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Note}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Subtle}"
                                       Visibility="{Binding Note, Converter={StaticResource NotEmptyToVisibility}}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Text="Fragmentation (free share of each heap)" FontWeight="SemiBold" Margin="0,8,0,4"
                             Visibility="{Binding HasFragments, Converter={StaticResource BoolToVisibility}}" />
                  <ItemsControl ItemsSource="{Binding Fragments}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,0,0,6">
                          <TextBlock Text="{Binding Text}" FontSize="11" TextWrapping="Wrap" />
                          <ProgressBar Height="6" Minimum="0" Maximum="1" Value="{Binding FreeFraction, Mode=OneWay}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>

              <StackPanel DockPanel.Dock="Top" DataContext="{Binding Selected}" Margin="0,0,0,6"
                          Visibility="{Binding Converter={StaticResource NotEmptyToVisibility}}">
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Summary}" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.Subtle}"><Run Text="Cause: " /><Run Text="{Binding Cause, Mode=OneWay}" /></TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.Subtle}"><Run Text="Fix: " /><Run Text="{Binding Fix, Mode=OneWay}" /></TextBlock>
              </StackPanel>
              <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                        GridLinesVisibility="None" RowHeight="22" CanUserSortColumns="False" SelectionMode="Single"
                        EnableRowVirtualization="True" EnableColumnVirtualization="True"
                        VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                        ScrollViewer.CanContentScroll="True"
                        ctl:GridColumns.NumberStyle="{StaticResource NumberCell}" ctl:GridColumns.Source="{Binding Columns}"
                        ctl:GridDrill.Command="{Binding OpenRowCommand}" ToolTip="Double-click or Enter opens the row's objects on the Snapshot tab." />
            </DockPanel>
          </TabItem>
        </TabControl>
      </DockPanel>
    </DataTemplate>

    <!-- Live monitoring (sprint 1.7, ADR-021): counters every interval, rule snapshots, a stacked heap chart. -->
    <DataTemplate DataType="{x:Type vm:LiveViewModel}">
      <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock FontSize="20" Text="Live" />
          <TextBlock Text="Watch a process's GC heap every interval, and take full dumps into the current session when a rule fires." Foreground="{DynamicResource Brush.Subtle}" Margin="0,0,0,8" />
          <WrapPanel Margin="0,0,0,6">
            <TextBlock Text="Process" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Width="320" ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock><Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" (pid " /><Run Text="{Binding ProcessId, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="Refresh" Margin="8,0,0,0" Padding="12,2" Command="{Binding RefreshCommand}" />
            <TextBlock Text="Sample every (s)" VerticalAlignment="Center" Margin="16,0,6,0" />
            <TextBox Width="40" VerticalContentAlignment="Center" Text="{Binding IntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
          </WrapPanel>
          <WrapPanel Margin="0,0,0,6">
            <TextBlock Text="Snapshot every (min)" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Width="50" VerticalContentAlignment="Center" Text="{Binding Every, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="when above" VerticalAlignment="Center" Margin="12,0,6,0" />
            <TextBox Width="70" VerticalContentAlignment="Center" Text="{Binding Above, UpdateSourceTrigger=PropertyChanged}" ToolTip="A size such as 500MB or 2GB." />
            <TextBlock Text="or grown by" VerticalAlignment="Center" Margin="12,0,6,0" />
            <TextBox Width="70" VerticalContentAlignment="Center" Text="{Binding Growth, UpdateSourceTrigger=PropertyChanged}" ToolTip="Over the first sample: a size such as 100MB or a percent such as 50%." />
            <TextBlock Text="then" VerticalAlignment="Center" Margin="12,0,6,0" />
            <ComboBox Width="80" ItemsSource="{Binding RearmModes}" SelectedItem="{Binding Rearm}"
                      ToolTip="below: again after the heap falls back under the threshold. once: never again. step: again for each further step." />
            <TextBlock Text="at most" VerticalAlignment="Center" Margin="12,0,6,0" />
            <TextBox Width="40" VerticalContentAlignment="Center" Text="{Binding MaxSnapshots, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Start" Margin="16,0,0,0" Padding="16,2" Command="{Binding StartCommand}" />
            <Button Content="Stop" Margin="8,0,0,0" Padding="16,2" Command="{Binding StopCommand}" />
          </WrapPanel>
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,4" Visibility="{Binding Status, Converter={StaticResource NotEmptyToVisibility}}" />
          <DockPanel Margin="0,0,0,6">
            <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.Growth}" CornerRadius="3" Padding="8,1"
                    Visibility="{Binding HighGcPressure, Converter={StaticResource BoolToVisibility}}"
                    ToolTip="The process spent 10 percent or more of the last ten intervals in garbage collection.">
              <TextBlock Text="High GC pressure" Foreground="White" FontWeight="SemiBold" />
            </Border>
            <TextBlock Text="{Binding Latest}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Latest}" Foreground="{DynamicResource Brush.Subtle}" />
          </DockPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <Border Width="10" Height="10" Background="{DynamicResource HeapKind.Gen0}" Margin="0,0,4,0" /><TextBlock Text="Gen0" Margin="0,0,10,0" FontSize="11" />
            <Border Width="10" Height="10" Background="{DynamicResource HeapKind.Gen1}" Margin="0,0,4,0" /><TextBlock Text="Gen1" Margin="0,0,10,0" FontSize="11" />
            <Border Width="10" Height="10" Background="{DynamicResource HeapKind.Gen2}" Margin="0,0,4,0" /><TextBlock Text="Gen2" Margin="0,0,10,0" FontSize="11" />
            <Border Width="10" Height="10" Background="{DynamicResource HeapKind.LargeObjectHeap}" Margin="0,0,4,0" /><TextBlock Text="LOH" Margin="0,0,10,0" FontSize="11" />
            <Border Width="10" Height="10" Background="{DynamicResource HeapKind.PinnedObjectHeap}" Margin="0,0,4,0" /><TextBlock Text="POH" Margin="0,0,10,0" FontSize="11" />
            <Border Width="10" Height="10" Background="{DynamicResource HeapKind.Unknown}" Margin="0,0,4,0" /><TextBlock Text="allocated since the last GC" Margin="0,0,10,0" FontSize="11" />
            <TextBlock Text="(generations as of the last GC; dashed line: snapshot)" FontSize="11" Foreground="{DynamicResource Brush.Subtle}" />
          </StackPanel>
        </StackPanel>
        <ScrollViewer DockPanel.Dock="Right" Width="300" Margin="8,0,0,0" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Snapshots}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,6">
                  <StackPanel>
                    <TextBlock><Run Text="{Binding Time, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Rule, Mode=OneWay}" /></TextBlock>
                    <TextBlock Text="{Binding Summary}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" Foreground="{DynamicResource Brush.Subtle}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="4" Padding="4">
          <ctl:TimelineChart Samples="{Binding Samples}" Markers="{Binding Markers}" Version="{Binding ChartVersion}" />
        </Border>
      </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ProcessesViewModel}">
      <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
          <TextBlock FontSize="20" Text="Processes" VerticalAlignment="Center" />
          <Button Content="Refresh" Margin="16,0,0,0" Padding="12,2" Command="{Binding RefreshCommand}" />
          <Button Content="Capture dump" Margin="8,0,0,0" Padding="12,2" Command="{Binding CaptureCommand}" />
        </StackPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Info.Background}" BorderBrush="{DynamicResource Brush.Info.Border}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,8"
                Visibility="{Binding ShowElevationHint, Converter={StaticResource BoolToVisibility}}">
          <TextBlock TextWrapping="Wrap"
                     Text="Processes marked 'Needs administrator' run elevated or as another user. To capture them, run HeapScope as administrator." />
        </Border>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <DataGrid ItemsSource="{Binding Processes}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="22" CanUserSortColumns="True"
                  EnableRowVirtualization="True" SelectionMode="Single" >
          <DataGrid.Columns>
            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70" ElementStyle="{StaticResource NumberCell}" />
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" />
            <DataGridTextColumn Header="Runtime" Binding="{Binding Runtime}" Width="130" />
            <DataGridTextColumn Header="Elevation" Binding="{Binding Elevation}" Width="140" />
            <DataGridTextColumn Header="Working set" Binding="{Binding WorkingSetBytes, StringFormat=N0}" Width="130" ElementStyle="{StaticResource NumberCell}" />
            <DataGridTextColumn Header="Command line" Binding="{Binding CommandLine}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:HomeViewModel}">
      <StackPanel Margin="16">
        <TextBlock FontSize="20" Text="Home" Margin="0,0,0,12" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Text="Open a full memory dump of a .NET process to see what is on its heap." />
        <Button Content="Open dump..." HorizontalAlignment="Left" Padding="16,4" Margin="0,0,0,24" Command="{Binding OpenDumpCommand}" />
        <DockPanel Margin="0,0,0,4">
          <Button DockPanel.Dock="Right" Content="Refresh" Padding="10,1" Command="{Binding RefreshSessionsCommand}" />
          <TextBlock Text="Recent sessions" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock Text="{Binding SessionStatus}" Foreground="{DynamicResource Brush.Subtle}" Margin="0,0,0,4" />
        <DataGrid ItemsSource="{Binding RecentSessions}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  GridLinesVisibility="None" RowHeight="22" MaxHeight="220" Margin="0,0,0,24" SelectionMode="Single"
                  >
          <DataGrid.Columns>
            <DataGridTextColumn Header="Session" Binding="{Binding Name}" Width="*" />
            <DataGridTextColumn Header="Created" Binding="{Binding CreatedUtc.LocalDateTime, StringFormat=g}" Width="140" />
            <DataGridTextColumn Header="Last opened" Binding="{Binding LastOpenedUtc.LocalDateTime, StringFormat=g}" Width="140" />
            <DataGridTextColumn Header="Snapshots" Binding="{Binding SnapshotCount}" Width="80" ElementStyle="{StaticResource NumberCell}" />
            <DataGridTextColumn Header="Bytes" Binding="{Binding SizeBytes, StringFormat=N0}" Width="130" ElementStyle="{StaticResource NumberCell}" />
            <DataGridTemplateColumn Width="70">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Content="Open" Padding="8,0" Margin="2,1"
                          Command="{Binding DataContext.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="Diagnostics" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource Brush.Subtle}"
                   Text="Run a synthetic graph job to exercise the analysis worker, progress and cancellation." />
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Objects:" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBox Width="140" Text="{Binding ObjectCount, UpdateSourceTrigger=PropertyChanged}" />
          <Button Content="Run synthetic job" Margin="8,0,0,0" Padding="12,2" Command="{Binding RunSyntheticCommand}" />
        </StackPanel>
        <TextBlock Margin="0,12,0,0" Text="{Binding LastResult}" TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:JobsPageViewModel}">
      <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
          <TextBlock FontSize="20" Text="Jobs" />
          <Button Content="Clear finished" Margin="16,0,0,0" Padding="12,2" Command="{Binding ClearFinishedCommand}" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Jobs}" />
        </ScrollViewer>
      </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:AboutViewModel}">
      <StackPanel Margin="16">
        <TextBlock FontSize="20" Text="About" Margin="0,0,0,12" />
        <TextBlock Text="{Binding ProductVersion}" />
        <TextBlock Margin="0,8,0,0" Text="{Binding WorkerDetails}" TextWrapping="Wrap" />
        <Button Content="Query worker" Margin="0,8,0,0" Padding="12,2" HorizontalAlignment="Left" Command="{Binding RefreshCommand}" />
        <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Foreground="Gray"
                   Text="Memory dumps can contain secrets. HeapScope never uploads anything." />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Error.Background}" BorderBrush="{DynamicResource Brush.Error.Border}" BorderThickness="0,0,0,1" Padding="12,6"
            Visibility="{Binding IsCrashBannerVisible, Converter={StaticResource BoolToVisibility}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Dismiss" Padding="10,1" Margin="8,0,0,0" Command="{Binding DismissCrashBannerCommand}" />
        <Button DockPanel.Dock="Right" Content="Restart worker" Padding="10,1" Command="{Binding RestartWorkerCommand}" />
        <TextBlock Text="{Binding CrashMessage}" VerticalAlignment="Center" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <!-- The Attribution Notice (ADDITIONAL-TERMS.md 1.2 and 1.3): always visible on the main screen, real selectable text in
         the body font size, theme text on an opaque surface (contrast above 13:1 in both themes, checked by a test). Do not
         remove, hide, shrink, restyle or move it. -->
    <Border x:Name="Attribution" DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
      <RichTextBox IsReadOnly="True" IsDocumentEnabled="True" BorderThickness="0" Padding="8,2" Focusable="True"
                   Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text}"
                   AutomationProperties.Name="Powered by HeapScope by Ray Klundt">
        <FlowDocument PagePadding="0">
          <Paragraph Margin="0">
            <Run Text="Powered by " /><Hyperlink NavigateUri="https://github.com/rklundt/HeapScope" RequestNavigate="OnAttributionNavigate"
                                                 Foreground="{DynamicResource Brush.Text}" ToolTip="https://github.com/rklundt/HeapScope">HeapScope</Hyperlink><Run Text=" by Ray Klundt" />
          </Paragraph>
        </FlowDocument>
      </RichTextBox>
    </Border>

    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem Content="{Binding WorkerStatus}" />
    </StatusBar>

    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,6" MaxHeight="160">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Jobs" FontWeight="SemiBold" Margin="0,0,0,4" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Jobs}" />
        </ScrollViewer>
      </DockPanel>
    </Border>

    <ListBox DockPanel.Dock="Left" Width="180" ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedItem}"
             DisplayMemberPath="Title" BorderThickness="0,0,1,0" Padding="4,8" />

    <!-- Each page is built when first shown and then kept: switching pages is a visibility change, not a rebuild of
         its grids, and keeps scroll positions and expanded state (sprint 1.5). -->
    <ItemsControl ItemsSource="{Binding NavigationItems}" Focusable="False">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <Grid />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <ContentControl Content="{Binding Page}" Focusable="False">
            <ContentControl.Visibility>
              <MultiBinding Converter="{StaticResource SameToVisibility}">
                <Binding />
                <Binding Path="DataContext.SelectedItem" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
              </MultiBinding>
            </ContentControl.Visibility>
          </ContentControl>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </DockPanel>
</Window>
