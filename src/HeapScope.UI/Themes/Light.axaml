<!-- HeapScope light theme (sprint 1.3, Avalonia since 2.3.6). Both themes define the same keys; a test checks it. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Brush.Window" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Brush.Text" Color="#FF1F2328" />
  <SolidColorBrush x:Key="Brush.Subtle" Color="#FF57606A" />
  <SolidColorBrush x:Key="Brush.Border" Color="#FFD0D7DE" />
  <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Brush.AltRow" Color="#FFF6F8FA" />
  <SolidColorBrush x:Key="Brush.Selection" Color="#FFDDF4FF" />
  <SolidColorBrush x:Key="Brush.Note.Background" Color="#FFFFF8C5" />
  <SolidColorBrush x:Key="Brush.Note.Border" Color="#FFD4A72C" />
  <SolidColorBrush x:Key="Brush.Info.Background" Color="#FFDDF4FF" />
  <SolidColorBrush x:Key="Brush.Info.Border" Color="#FF54AEFF" />
  <SolidColorBrush x:Key="Brush.Error.Background" Color="#FFFDECEA" />
  <SolidColorBrush x:Key="Brush.Error.Border" Color="#FFD93025" />
  <!-- Diff deltas (sprint 1.4): growth and shrinkage. -->
  <SolidColorBrush x:Key="Brush.Growth" Color="#FFCF222E" />
  <SolidColorBrush x:Key="Brush.Shrink" Color="#FF1A7F37" />
  <!-- The icicle chart (sprint 2.4): alternate levels, and the path to the selected bar. -->
  <SolidColorBrush x:Key="Icicle.Bar1" Color="#FFB6D4F2" />
  <SolidColorBrush x:Key="Icicle.Bar2" Color="#FF9CC3EA" />
  <SolidColorBrush x:Key="Icicle.Path" Color="#FFF2C46D" />
  <!-- Allocations timeline (sprint 2.5): the bars and the selected interval, green as in the dotMemory research. -->
  <SolidColorBrush x:Key="Allocation.Bar" Color="#FF6FA3D6" />
  <SolidColorBrush x:Key="Allocation.Interval" Color="#5548B860" />
  <SolidColorBrush x:Key="HeapKind.Unknown" Color="#FF9E9E9E" />
  <SolidColorBrush x:Key="HeapKind.Gen0" Color="#FF4CAF50" />
  <SolidColorBrush x:Key="HeapKind.Gen1" Color="#FF2196F3" />
  <SolidColorBrush x:Key="HeapKind.Gen2" Color="#FF673AB7" />
  <SolidColorBrush x:Key="HeapKind.LargeObjectHeap" Color="#FFFF9800" />
  <SolidColorBrush x:Key="HeapKind.PinnedObjectHeap" Color="#FFE91E63" />
  <SolidColorBrush x:Key="HeapKind.Frozen" Color="#FF607D8B" />
</ResourceDictionary>
