<!-- HeapScope dark theme (sprint 1.3, Avalonia since 2.3.6). Both themes define the same keys; a test checks it. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Brush.Window" Color="#FF14171B" />
  <SolidColorBrush x:Key="Brush.Text" Color="#FFE6EAF0" />
  <SolidColorBrush x:Key="Brush.Subtle" Color="#FF9BA5B1" />
  <SolidColorBrush x:Key="Brush.Border" Color="#FF2E343C" />
  <SolidColorBrush x:Key="Brush.Surface" Color="#FF1A1D22" />
  <SolidColorBrush x:Key="Brush.AltRow" Color="#FF20242A" />
  <SolidColorBrush x:Key="Brush.Selection" Color="#FF2A2E52" />
  <SolidColorBrush x:Key="Brush.Note.Background" Color="#FF3B3220" />
  <SolidColorBrush x:Key="Brush.Note.Border" Color="#FF9E7B23" />
  <SolidColorBrush x:Key="Brush.Info.Background" Color="#FF20234A" />
  <SolidColorBrush x:Key="Brush.Info.Border" Color="#FFA5B4FC" />
  <SolidColorBrush x:Key="Brush.Error.Background" Color="#FF3D1F1D" />
  <SolidColorBrush x:Key="Brush.Error.Border" Color="#FFF85149" />
  <SolidColorBrush x:Key="Brush.Rail" Color="#FF111418" />
  <SolidColorBrush x:Key="Brush.Header" Color="#FF20242A" />
  <SolidColorBrush x:Key="Brush.BorderStrong" Color="#FF6B7480" />
  <SolidColorBrush x:Key="Brush.Accent" Color="#FFA5B4FC" />
  <SolidColorBrush x:Key="Brush.OnAccent" Color="#FF14171B" />
  <!-- Bookmark marks (sprint 2.7). -->
  <SolidColorBrush x:Key="Brush.Mark.Red" Color="#FFF85149" />
  <SolidColorBrush x:Key="Brush.Mark.Orange" Color="#FFF0883E" />
  <SolidColorBrush x:Key="Brush.Mark.Green" Color="#FF3FB950" />
  <SolidColorBrush x:Key="Brush.Mark.Blue" Color="#FF58A6FF" />
  <SolidColorBrush x:Key="Brush.Mark.Purple" Color="#FFBC8CFF" />
  <!-- Diff deltas (sprint 1.4): growth and shrinkage. -->
  <SolidColorBrush x:Key="Brush.Growth" Color="#FFFF7B72" />
  <SolidColorBrush x:Key="Brush.Shrink" Color="#FF3FB950" />
  <!-- The icicle chart (sprint 2.4): alternate levels, and the path to the selected bar. -->
  <SolidColorBrush x:Key="Icicle.Bar1" Color="#FF3B3F80" />
  <SolidColorBrush x:Key="Icicle.Bar2" Color="#FF343A43" />
  <SolidColorBrush x:Key="Icicle.Path" Color="#FFE0B15A" />
  <SolidColorBrush x:Key="Icicle.PathText" Color="#FF14171B" />
  <!-- Allocations timeline (sprint 2.5): the bars and the selected interval. -->
  <SolidColorBrush x:Key="Allocation.Bar" Color="#FF7C86E8" />
  <SolidColorBrush x:Key="Allocation.Interval" Color="#55A5B4FC" />
  <!-- The heap kinds; Unknown is also the Live chart's "allocated since the last GC" layer. -->
  <SolidColorBrush x:Key="HeapKind.Unknown" Color="#FF5B6470" />
  <SolidColorBrush x:Key="HeapKind.Gen0" Color="#FF4CC9B8" />
  <SolidColorBrush x:Key="HeapKind.Gen1" Color="#FF6DB6EE" />
  <SolidColorBrush x:Key="HeapKind.Gen2" Color="#FF3F8FD6" />
  <SolidColorBrush x:Key="HeapKind.LargeObjectHeap" Color="#FFF2A93B" />
  <SolidColorBrush x:Key="HeapKind.PinnedObjectHeap" Color="#FFEE6F9E" />
  <SolidColorBrush x:Key="HeapKind.Frozen" Color="#FF8D9AA8" />
  <!-- Fluent's own keys, so its controls follow these colors (ADR-040). -->
  <SolidColorBrush x:Key="TextControlBorderBrush" Color="#FF6B7480" />
  <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#FF6B7480" />
  <SolidColorBrush x:Key="DataGridColumnHeaderBackgroundBrush" Color="#FF20242A" />
  <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="#FFA5B4FC" />
  <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="#FF2A2E52" />
  <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="#FF2A2E52" />
  <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="#FF2A2E52" />
  <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" Color="#FF2A2E52" />
  <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="#FF2A2E52" />
  <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="#FF2A2E52" />
  <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed" Color="#FF2A2E52" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#FF2A2E52" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#FF2A2E52" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#FF2A2E52" />
  <SolidColorBrush x:Key="TreeViewItemForegroundSelected" Color="#FFE6EAF0" />
  <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPointerOver" Color="#FFE6EAF0" />
  <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPressed" Color="#FFE6EAF0" />
  <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#FFE6EAF0" />
  <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#FFE6EAF0" />
  <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed" Color="#FFE6EAF0" />
  <SolidColorBrush x:Key="TabItemHeaderForegroundSelected" Color="#FFE6EAF0" />
  <SolidColorBrush x:Key="TabItemHeaderForegroundSelectedPointerOver" Color="#FFE6EAF0" />
  <SolidColorBrush x:Key="TabItemHeaderForegroundSelectedPressed" Color="#FFE6EAF0" />
  <SolidColorBrush x:Key="TabItemHeaderForegroundUnselected" Color="#FF9BA5B1" />
  <SolidColorBrush x:Key="TabItemHeaderForegroundUnselectedPointerOver" Color="#FF9BA5B1" />
</ResourceDictionary>
