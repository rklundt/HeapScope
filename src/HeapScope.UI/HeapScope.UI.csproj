<Project Sdk="Microsoft.NET.Sdk">
  <!-- The HeapScope desktop app on Avalonia, for Windows, Linux and macOS (sprint 2.3.6, ADR-025). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>HeapScope</AssemblyName>
    <RootNamespace>HeapScope.UI</RootNamespace>
    <!-- Bindings are compiled and checked at build time (x:DataType on every view). -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Precompiled when published for a runtime (dotnet publish -r <rid>); measured in sprint 1.2. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!--
      The runtime identifiers it is published for, stated so that every SDK restores the same set: newer SDKs add the
      machine's own for ReadyToRun, which made the lock file differ by SDK (sprint 3.7).
    -->
    <RuntimeIdentifiers>win-x64;linux-x64;osx-arm64;osx-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\HeapScope.Application\HeapScope.Application.csproj" />
    <ProjectReference Include="..\HeapScope.Contracts\HeapScope.Contracts.csproj" />
    <ProjectReference Include="..\HeapScope.UI.ViewModels\HeapScope.UI.ViewModels.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <!-- Runs the app without a display (smoke runs in CI, the UI tests). -->
    <PackageReference Include="Avalonia.Headless" />
    <!--
      Avalonia.Headless depends on the Inter typeface (SIL OFL 1.1, not on the allowed license list, DEVELOPER.md 4): none
      of its files ship. Headless runs draw with Skia and the system's fonts (sprint 2.3.6 review).
    -->
    <PackageReference Include="Avalonia.Fonts.Inter" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HeapScope.UI.Tests" />
  </ItemGroup>
  <Import Project="$(HeapScopeRoot)build\Worker.Deploy.targets" />
</Project>
