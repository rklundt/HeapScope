<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:HeapScope.UI.Controls"
             xmlns:vm="using:HeapScope.UI.ViewModels"
             x:Class="HeapScope.UI.Views.Pages.ProcessesPage"
             x:DataType="vm:ProcessesViewModel">
  <DockPanel Margin="4">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Classes="pageTitle" Text="Processes" VerticalAlignment="Center" />
        <ctl:InfoIcon Text="{x:Static vm:InfoTexts.Processes}" />
      </StackPanel>
      <Button ctl:ButtonIcon.Icon="Refresh" Content="Refresh" Margin="16,0,0,0" Command="{Binding RefreshCommand}" />
      <Button ctl:ButtonIcon.Icon="Capture" Classes="primary" Content="Capture dump" Margin="8,0,0,0" Command="{Binding CaptureCommand}" />
      <CheckBox Content="As gcdump" Margin="12,0,0,0" VerticalAlignment="Center" IsChecked="{Binding CaptureGcDump}" />
      <ctl:InfoIcon Text="{x:Static vm:InfoTexts.CaptureOptions}" Margin="4,0,0,0" VerticalAlignment="Center" />
      <!-- Sprint 2.5: sampled allocations with call stacks, shown on the Allocations page when done. -->
      <Button Content="Record allocations" Margin="16,0,0,0" Command="{Binding RecordAllocationsCommand}" IsVisible="{Binding CanRecordAllocations}"
              ToolTip.Tip="Records which types and call stacks allocate, for up to 30 seconds, while you use the application. The process keeps running; Stop keeps what was recorded. Needs a selected process, on Windows, with no recording running." />
      <Button ctl:ButtonIcon.Icon="Stop" Content="Stop" Margin="8,0,0,0" Command="{Binding StopRecordingCommand}" IsVisible="{Binding IsRecording}" />
    </StackPanel>
    <!-- Sprint 2.3.6: where capture is not available (Linux, macOS for now), the page says why and what to do instead. -->
    <Border DockPanel.Dock="Top" Classes="info" Margin="0,0,0,8"
            IsVisible="{Binding Unavailable, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <SelectableTextBlock TextWrapping="Wrap" Text="{Binding Unavailable}" />
    </Border>
    <Border DockPanel.Dock="Top" Classes="info" Margin="0,0,0,8" IsVisible="{Binding ShowElevationHint}">
      <TextBlock TextWrapping="Wrap"
                 Text="Processes marked 'Needs administrator' run elevated or as another user. To capture them, run HeapScope as administrator." />
    </Border>
    <ctl:NoteText DockPanel.Dock="Top" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,8" />
    <DataGrid ItemsSource="{Binding Processes}" ctl:GridExports.ExportName="Processes" SelectedItem="{Binding Selected, Mode=TwoWay}" CanUserSortColumns="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="PID" x:DataType="vm:ProcessRow" Binding="{Binding ProcessId}" Width="70" CellStyleClasses="number" />
        <DataGridTextColumn Header="Name" x:DataType="vm:ProcessRow" Binding="{Binding Name}" Width="200" />
        <DataGridTextColumn Header="Runtime" x:DataType="vm:ProcessRow" Binding="{Binding Runtime}" Width="130" />
        <DataGridTextColumn x:DataType="vm:ProcessRow" Binding="{Binding Elevation}" Width="140">
          <DataGridTextColumn.Header>
            <TextBlock Text="Elevation" ToolTip.Tip="&quot;Needs administrator&quot; means you must run HeapScope as administrator to capture this process. &quot;Elevated&quot; means it runs elevated and HeapScope does too." />
          </DataGridTextColumn.Header>
        </DataGridTextColumn>
        <DataGridTextColumn x:DataType="vm:ProcessRow" Binding="{Binding WorkingSetBytes, StringFormat='{}{0:N0}'}" Width="130" CellStyleClasses="number">
          <DataGridTextColumn.Header>
            <TextBlock Text="Working set" ToolTip.Tip="Physical memory the operating system has given the whole process right now, not only its .NET heap." />
          </DataGridTextColumn.Header>
        </DataGridTextColumn>
        <!-- A command line can carry secrets: an export leaves it out unless the person opts in (ADR-026, 2.7 review H1). -->
        <DataGridTextColumn Header="Command line" x:DataType="vm:ProcessRow" Binding="{Binding CommandLine}" Width="*" MinWidth="240" ctl:GridExports.HasValues="True" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
