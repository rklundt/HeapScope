<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HeapScope.UI.ViewModels"
             x:Class="HeapScope.UI.Views.Pages.ProcessesPage"
             x:DataType="vm:ProcessesViewModel">
  <DockPanel Margin="4">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock FontSize="20" Text="Processes" VerticalAlignment="Center" />
      <Button Content="Refresh" Margin="16,0,0,0" Command="{Binding RefreshCommand}" />
      <Button Content="Capture dump" Margin="8,0,0,0" Command="{Binding CaptureCommand}" />
      <CheckBox Content="As gcdump" Margin="12,0,0,0" VerticalAlignment="Center" IsChecked="{Binding CaptureGcDump}"
                ToolTip.Tip="The object graph only: much smaller and quicker to open, but no field values, string text or generations. The process runs one full garbage collection." />
    </StackPanel>
    <!-- Sprint 2.3.6: where capture is not available (Linux, macOS for now), the page says why and what to do instead. -->
    <Border DockPanel.Dock="Top" Classes="info" Margin="0,0,0,8"
            IsVisible="{Binding Unavailable, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <SelectableTextBlock TextWrapping="Wrap" Text="{Binding Unavailable}" />
    </Border>
    <Border DockPanel.Dock="Top" Classes="info" Margin="0,0,0,8" IsVisible="{Binding ShowElevationHint}">
      <TextBlock TextWrapping="Wrap"
                 Text="Processes marked 'Needs administrator' run elevated or as another user. To capture them, run HeapScope as administrator." />
    </Border>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,8"
               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <DataGrid ItemsSource="{Binding Processes}" SelectedItem="{Binding Selected, Mode=TwoWay}" CanUserSortColumns="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="PID" x:DataType="vm:ProcessRow" Binding="{Binding ProcessId}" Width="70" CellStyleClasses="number" />
        <DataGridTextColumn Header="Name" x:DataType="vm:ProcessRow" Binding="{Binding Name}" Width="200" />
        <DataGridTextColumn Header="Runtime" x:DataType="vm:ProcessRow" Binding="{Binding Runtime}" Width="130" />
        <DataGridTextColumn Header="Elevation" x:DataType="vm:ProcessRow" Binding="{Binding Elevation}" Width="140" />
        <DataGridTextColumn Header="Working set" x:DataType="vm:ProcessRow" Binding="{Binding WorkingSetBytes, StringFormat='{}{0:N0}'}" Width="130" CellStyleClasses="number" />
        <DataGridTextColumn Header="Command line" x:DataType="vm:ProcessRow" Binding="{Binding CommandLine}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
