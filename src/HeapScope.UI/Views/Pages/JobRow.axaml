<!-- One job in the shell's jobs list and on the Jobs page. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HeapScope.UI.ViewModels"
             x:Class="HeapScope.UI.Views.Pages.JobRow"
             x:DataType="vm:JobViewModel">
  <Grid ColumnDefinitions="280,*,240,Auto" Margin="0,2">
    <TextBlock Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    <ProgressBar Grid.Column="1" Height="14" MinHeight="14" Margin="8,0" Minimum="0" Maximum="100"
                 Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" />
    <TextBlock Grid.Column="2" Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    <Button Grid.Column="3" Content="Cancel" Padding="8,1" Command="{Binding CancelCommand}" />
  </Grid>
</UserControl>
