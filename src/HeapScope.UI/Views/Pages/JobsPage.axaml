<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HeapScope.UI.ViewModels"
             x:Class="HeapScope.UI.Views.Pages.JobsPage"
             x:DataType="vm:JobsPageViewModel">
  <DockPanel Margin="4">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
      <TextBlock FontSize="20" Text="Jobs" />
      <Button Content="Clear finished" Margin="16,0,0,0" Command="{Binding ClearFinishedCommand}" />
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Jobs}" />
    </ScrollViewer>
  </DockPanel>
</UserControl>
