<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:HeapScope.UI.Controls"
             xmlns:vm="using:HeapScope.UI.ViewModels"
             xmlns:sessions="using:HeapScope.Application.Sessions"
             x:Class="HeapScope.UI.Views.Pages.HomePage"
             x:DataType="vm:HomeViewModel">
  <ScrollViewer>
    <StackPanel Margin="4">
      <TextBlock FontSize="20" Text="Home" Margin="0,0,0,12" />
      <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Text="Open a full memory dump of a .NET process to see what is on its heap." />
      <Button Content="Open dump..." HorizontalAlignment="Left" Padding="16,4" Margin="0,0,0,24" Command="{Binding OpenDumpCommand}" />
      <DockPanel Margin="0,0,0,4">
        <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshSessionsCommand}" />
        <TextBlock Text="Recent sessions" FontWeight="SemiBold" VerticalAlignment="Center" />
      </DockPanel>
      <ctl:NoteText Text="{Binding SessionStatus}" Classes="subtle" Margin="0,0,0,4" />
      <DataGrid x:Name="Sessions" ctl:GridExports.ExportName="Sessions" ItemsSource="{Binding RecentSessions}" MaxHeight="220" Margin="0,0,0,24">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Session" x:DataType="sessions:SessionSummary" Binding="{Binding Name}" Width="*" />
          <DataGridTextColumn Header="Created" x:DataType="sessions:SessionSummary" Binding="{Binding CreatedUtc.LocalDateTime, StringFormat='{}{0:g}'}" Width="140" />
          <DataGridTextColumn Header="Last opened" x:DataType="sessions:SessionSummary" Binding="{Binding LastOpenedUtc.LocalDateTime, StringFormat='{}{0:g}'}" Width="140" />
          <DataGridTextColumn Header="Snapshots" x:DataType="sessions:SessionSummary" Binding="{Binding SnapshotCount}" Width="90" CellStyleClasses="number" />
          <DataGridTextColumn Header="Bytes" x:DataType="sessions:SessionSummary" Binding="{Binding SizeBytes, StringFormat='{}{0:N0}'}" Width="130" CellStyleClasses="number" />
          <DataGridTemplateColumn Width="80">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="sessions:SessionSummary">
                <Button Content="Open" Padding="8,0" Margin="2,1"
                        Command="{Binding $parent[DataGrid].((vm:HomeViewModel)DataContext).OpenSessionCommand}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="Diagnostics" FontWeight="SemiBold" Margin="0,0,0,4" />
      <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Classes="subtle"
                 Text="Run a synthetic graph job to exercise the analysis worker, progress and cancellation." />
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Objects:" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBox Width="140" Text="{Binding ObjectCount}" />
        <Button Content="Run synthetic job" Margin="8,0,0,0" Command="{Binding RunSyntheticCommand}" />
      </StackPanel>
      <TextBlock Margin="0,12,0,0" Text="{Binding LastResult}" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
