<!-- The Snapshot tab (sprints 1.3 to 2.3): the open snapshot's overview, then its subjects with back and forward: the types
     grid, a type's objects, one object (fields, references, retention), a type's referrers and its key paths. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HeapScope.UI.ViewModels"
             xmlns:ctl="using:HeapScope.UI.Controls"
             xmlns:subjects="using:HeapScope.UI.Views.Subjects"
             x:Class="HeapScope.UI.Views.Pages.SnapshotTab"
             x:DataType="vm:SnapshotsViewModel">
  <Grid Margin="0,8,0,0">
    <TextBlock Text="Open a full memory dump (.dmp) to see what is on the heap." Classes="subtle"
               IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNull}}" />

    <DockPanel IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel DockPanel.Dock="Top" DataContext="{Binding Selected}" x:DataType="vm:SnapshotItemViewModel">
        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Process}" Classes="subtle" />
        <TextBlock Text="{Binding Source}" Classes="subtle" Margin="0,0,0,8" />
        <WrapPanel>
          <Border Classes="tile"><StackPanel><TextBlock Text="Objects" Classes="subtle" FontSize="11" /><TextBlock Text="{Binding Objects}" FontSize="18" FontWeight="SemiBold" /></StackPanel></Border>
          <Border Classes="tile"><StackPanel><TextBlock Text="Heap size" Classes="subtle" FontSize="11" /><TextBlock Text="{Binding Size}" FontSize="18" FontWeight="SemiBold" /></StackPanel></Border>
          <Border Classes="tile"><StackPanel><TextBlock Text="Types" Classes="subtle" FontSize="11" /><TextBlock Text="{Binding Types}" FontSize="18" FontWeight="SemiBold" /></StackPanel></Border>
          <Border Classes="tile"><StackPanel><TextBlock Text="References" Classes="subtle" FontSize="11" /><TextBlock Text="{Binding References}" FontSize="18" FontWeight="SemiBold" /></StackPanel></Border>
          <Border Classes="tile"><StackPanel><TextBlock Text="Roots" Classes="subtle" FontSize="11" /><TextBlock Text="{Binding Roots}" FontSize="18" FontWeight="SemiBold" /></StackPanel></Border>
        </WrapPanel>
        <Border Classes="note" IsVisible="{Binding HasNotes}">
          <ItemsControl ItemsSource="{Binding Notes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <SelectableTextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>

      <!-- Subjects (sprint 1.5): the types grid, a type's objects, one object, a type's referrers (2.1) and paths (2.2); back and forward. -->
      <DockPanel DataContext="{Binding Navigator}" x:DataType="vm:NavigatorViewModel">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
          <Button Content="Back" Command="{Binding BackCommand}" ToolTip.Tip="Back along the analysis path (Alt+Left or the mouse's back button)" />
          <Button Content="Forward" Margin="4,0,0,0" Command="{Binding ForwardCommand}" ToolTip.Tip="Forward along the analysis path (Alt+Right or the mouse's forward button)" />
          <ItemsControl ItemsSource="{Binding Trail}" Margin="12,0,0,0" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AnalysisStep">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text=" / " Classes="subtle" />
                  <TextBlock Text="{Binding Title}" MaxWidth="360" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- One view per kind of subject, built with the page; the navigator swaps their data (sprint 1.5). -->
        <Grid>
          <!-- Types. -->
          <Panel IsVisible="{Binding IsTypesShown}">
            <subjects:TypesView DataContext="{Binding Types}" />
          </Panel>

          <!-- A type's objects (sprint 1.5). -->
          <Panel IsVisible="{Binding IsInstancesShown}">
            <subjects:InstancesView DataContext="{Binding ShownInstances}" />
          </Panel>

          <!-- One object (sprint 1.5): fields, references both ways (2.1), retention and retained size (2.2, 2.3). -->
          <Panel IsVisible="{Binding IsObjectShown}">
            <subjects:ObjectView DataContext="{Binding ShownObject}" />
          </Panel>

          <!-- Who references a type's objects (sprint 2.1). -->
          <Panel IsVisible="{Binding IsTypeReferrersShown}">
            <subjects:TypeReferrersView DataContext="{Binding ShownTypeReferrers}" />
          </Panel>

          <!-- Why a type's objects are alive: key retention paths (sprint 2.2). -->
          <Panel IsVisible="{Binding IsTypePathsShown}">
            <subjects:TypePathsView DataContext="{Binding ShownTypePaths}" />
          </Panel>
        </Grid>
      </DockPanel>
    </DockPanel>
  </Grid>
</UserControl>
