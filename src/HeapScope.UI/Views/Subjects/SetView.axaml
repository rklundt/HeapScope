<!-- An object set (sprint 3.1, ADR-030): its views (Types, Instances, Generations, Dominators) and what it retains. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HeapScope.UI.ViewModels"
             xmlns:ctl="using:HeapScope.UI.Controls"
             xmlns:dto="using:HeapScope.Contracts"
             xmlns:subjects="using:HeapScope.UI.Views.Subjects"
             x:Class="HeapScope.UI.Views.Subjects.SetView"
             x:DataType="vm:SetViewModel">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,8,6">
      <Button DockPanel.Dock="Right" Content="{x:Static dto:ValueBoundTexts.SetAction}" Command="{Binding RetainedCommand}"
              ToolTip.Tip="What the set's objects keep alive together, exactly, on the Retainers tab." />
      <TextBlock Text="Set" Classes="subtle" VerticalAlignment="Center" Margin="0,0,6,0" />
      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
    </DockPanel>

    <!-- The view switcher: one list item per view, keyboard reachable (arrow keys). -->
    <ListBox x:Name="ViewList" DockPanel.Dock="Top" ItemsSource="{Binding Views}" SelectedItem="{Binding View, Mode=TwoWay}"
             AutomationProperties.Name="Set views" Margin="0,0,8,6">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
    </ListBox>

    <Grid>
      <Panel IsVisible="{Binding IsTypesShown}">
        <subjects:TypesView DataContext="{Binding Types}" />
      </Panel>

      <Panel IsVisible="{Binding IsInstancesShown}">
        <subjects:InstancesView DataContext="{Binding Instances}" />
      </Panel>

      <!-- Generations: the set's objects and bytes per heap kind, from its Types query. -->
      <Panel IsVisible="{Binding IsGenerationsShown}">
        <StackPanel DataContext="{Binding Types}" x:DataType="vm:TypeSummaryViewModel">
          <ctl:NoteText Text="{Binding GenerationsExplanation}" TextWrapping="Wrap" Classes="subtle" Margin="0,0,0,6" />
          <ItemsControl ItemsSource="{Binding HeapKinds}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HeapKindShare">
                <Grid ColumnDefinitions="16,170,130,150,*" Margin="0,2">
                  <Border Width="10" Height="10" VerticalAlignment="Center" Background="{Binding BrushKey, Converter={x:Static ctl:ResourceKeyToBrushConverter.Instance}}" />
                  <TextBlock Grid.Column="1" Text="{Binding Label}" />
                  <TextBlock Grid.Column="2" Text="{Binding Objects, StringFormat='{}{0:N0} objects'}" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="3" Text="{Binding Bytes, StringFormat='{}{0:N0} bytes'}" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="4" Text="{Binding Fraction, StringFormat='{}{0:P1}'}" Margin="12,0,0,0" Classes="subtle" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Panel>

      <!-- Dominators: the members no other member holds, with what each retains. -->
      <Panel IsVisible="{Binding IsDominatorsShown}">
        <DockPanel DataContext="{Binding Dominators}" x:DataType="vm:SetDominatorsViewModel">
          <ctl:NoteText DockPanel.Dock="Top" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,8,4" />
          <ctl:NoteText DockPanel.Dock="Top" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,4" />
          <DataGrid x:Name="SetDominatorsGrid" ctl:GridExports.ExportName="SetDominators" CanUserSortColumns="False"
                    ctl:GridBehaviors.ResultColumns="{Binding Columns}"
                    ctl:GridBehaviors.Rows="{Binding Rows}"
                    ctl:GridBehaviors.OpenCommand="{Binding OpenRowCommand}"
                    ToolTip.Tip="Double-click or Enter opens the object; right-click shows it in the dominator tree.">
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Show in dominator tree" Command="{Binding ShowInRetainersCommand}" CommandParameter="{Binding #SetDominatorsGrid.SelectedItem}" />
              </ContextMenu>
            </DataGrid.ContextMenu>
          </DataGrid>
        </DockPanel>
      </Panel>
    </Grid>
  </DockPanel>
</UserControl>
