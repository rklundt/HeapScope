<!-- One object (sprint 1.5): fields, references, referrers, retention paths and retained size. Split from the Snapshot tab in sprint 2.4 (2.3.7 review M8). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HeapScope.UI.ViewModels"
             xmlns:ctl="using:HeapScope.UI.Controls"
             x:Class="HeapScope.UI.Views.Subjects.ObjectView"
             x:DataType="vm:ObjectViewModel">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,8,4">
      <Button DockPanel.Dock="Right" Content="Show in dominator tree" Command="{Binding ShowInRetainersCommand}" VerticalAlignment="Top"
              ToolTip.Tip="What this object alone keeps alive, and what keeps it alive, on the Retainers tab" />
      <SelectableTextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
    </DockPanel>
    <ctl:NoteText DockPanel.Dock="Top" Text="{Binding Status}" Margin="0,0,0,4" />
    <Border DockPanel.Dock="Top" Classes="info" IsVisible="{Binding FieldsUnavailable, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding FieldsUnavailable}" TextWrapping="Wrap" />
    </Border>
    <TextBox DockPanel.Dock="Top" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120" Margin="0,0,8,6"
             IsVisible="{Binding Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <Grid ColumnDefinitions="*,8,*">
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="Fields" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TreeView x:Name="FieldsTree" ItemsSource="{Binding Fields}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
          <TreeView.Styles>
            <Style Selector="TreeViewItem" x:DataType="vm:FieldNode">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            </Style>
          </TreeView.Styles>
          <TreeView.ItemTemplate>
            <TreeDataTemplate DataType="vm:FieldNode" ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" />
                <HyperlinkButton Content="{Binding Value}" Padding="0" IsVisible="{Binding IsLink}" VerticalAlignment="Center"
                                 Command="{Binding $parent[TreeView].((vm:ObjectViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}"
                                 ToolTip.Tip="Open this object" />
                <TextBlock Text="{Binding Value}" IsVisible="{Binding !IsLink}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TypeName}" Margin="8,0,0,0" FontSize="11" Classes="subtle" VerticalAlignment="Center" />
              </StackPanel>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </DockPanel>
      <!-- Outgoing references (1.5) and the objects referencing this one (2.1, loaded when its tab is first shown). -->
      <TabControl Grid.Column="2" SelectedIndex="{Binding ReferencesTab, Mode=TwoWay}">
        <TabItem Header="Outgoing">
          <DockPanel Margin="0,4,0,0">
            <TextBlock DockPanel.Dock="Top" Text="{Binding ReferencesTotals}" Margin="0,0,0,4" Classes="subtle" />
            <DataGrid x:Name="ReferencesGrid" CanUserSortColumns="False"
                      ctl:GridBehaviors.Rows="{Binding ReferenceRows}" ctl:GridBehaviors.OpenCommand="{Binding OpenCommand}"
                      ToolTip.Tip="Double-click or Enter opens the referenced object.">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Field" x:DataType="vm:ReferenceRowItem" Binding="{Binding Field}" Width="140" />
                <DataGridTextColumn Header="Address" x:DataType="vm:ReferenceRowItem" Binding="{Binding AddressText}" Width="140" CellStyleClasses="address" />
                <DataGridTextColumn Header="Type" x:DataType="vm:ReferenceRowItem" Binding="{Binding Type}" Width="*" />
                <DataGridTextColumn Header="Bytes" x:DataType="vm:ReferenceRowItem" Binding="{Binding Bytes, StringFormat='{}{0:N0}'}" Width="90" CellStyleClasses="number" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>
        <TabItem Header="Incoming">
          <DockPanel Margin="0,4,0,0">
            <ctl:NoteText DockPanel.Dock="Top" Text="{Binding IncomingTotals}" Margin="0,0,0,4" Classes="subtle" />
            <ctl:NoteText DockPanel.Dock="Top" Text="{Binding IncomingStatus}" Margin="0,0,0,4" TextWrapping="Wrap" Classes="subtle" />
            <DataGrid x:Name="IncomingGrid" CanUserSortColumns="False"
                      ctl:GridBehaviors.Rows="{Binding IncomingRows}" ctl:GridBehaviors.OpenCommand="{Binding OpenCommand}"
                      ToolTip.Tip="Double-click or Enter opens the referencing object.">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Field" x:DataType="vm:ReferrerRowItem" Binding="{Binding Field}" Width="140" />
                <DataGridTextColumn Header="Address" x:DataType="vm:ReferrerRowItem" Binding="{Binding AddressText}" Width="140" CellStyleClasses="address" />
                <DataGridTextColumn Header="Type" x:DataType="vm:ReferrerRowItem" Binding="{Binding Type}" Width="*" />
                <DataGridTextColumn Header="Bytes" x:DataType="vm:ReferrerRowItem" Binding="{Binding Bytes, StringFormat='{}{0:N0}'}" Width="90" CellStyleClasses="number" />
                <DataGridTextColumn Header="Refs" x:DataType="vm:ReferrerRowItem" Binding="{Binding References, StringFormat='{}{0:N0}'}" Width="60" CellStyleClasses="number" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>
        <!-- Sprint 2.2: why the object is alive, loaded when the tab is first shown. -->
        <TabItem Header="Retention">
          <DockPanel Margin="0,4,0,0">
            <ctl:NoteText DockPanel.Dock="Top" Text="{Binding RetentionStatus}" Margin="0,0,0,4" TextWrapping="Wrap" Classes="subtle" />
            <!-- Sprint 2.3: the retained size and the immediate dominator, a link to open it. -->
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4"
                       IsVisible="{Binding RetainedSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{Binding RetainedSummary}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,4,0" />
              <HyperlinkButton Content="{Binding DominatorText}" Padding="0" VerticalAlignment="Center"
                               Command="{Binding OpenCommand}" CommandParameter="{Binding DominatorAddress}"
                               IsVisible="{Binding DominatorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               ToolTip.Tip="Open the immediate dominator: the closest object every path from a root to this one passes through" />
            </WrapPanel>
            <CheckBox DockPanel.Dock="Top" Content="Show framework steps" IsChecked="{Binding ShowFrameworkSteps, Mode=TwoWay}" Margin="0,0,0,4"
                      ToolTip.Tip="Runs of System and Microsoft objects between other steps are folded into one line unless shown." />
            <DataGrid x:Name="KeyPathsGrid" DockPanel.Dock="Top" ItemsSource="{Binding KeyPaths}" CanUserSortColumns="False" MaxHeight="140" Margin="0,0,0,6"
                      ctl:GridBehaviors.OpenCommand="{Binding OpenCommand}"
                      ToolTip.Tip="Key paths among the roots found. Double-click or Enter opens the root's object.">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Roots" x:DataType="vm:KeyPathItem" Binding="{Binding Objects, StringFormat='{}{0:N0}'}" Width="60" CellStyleClasses="number" />
                <DataGridTextColumn Header="Root" x:DataType="vm:KeyPathItem" Binding="{Binding Root}" Width="*" />
                <DataGridTextColumn Header="Path" x:DataType="vm:KeyPathItem" Binding="{Binding PathText}" Width="2*" />
              </DataGrid.Columns>
            </DataGrid>
            <TreeView x:Name="RetentionTree" ItemsSource="{Binding RetentionTree}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
              <TreeView.Styles>
                <Style Selector="TreeViewItem" x:DataType="vm:RetentionNodeItem">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                </Style>
              </TreeView.Styles>
              <TreeView.ItemTemplate>
                <TreeDataTemplate DataType="vm:RetentionNodeItem" ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Text}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <HyperlinkButton Content="{Binding AddressText}" Padding="0" FontFamily="Consolas, Menlo, DejaVu Sans Mono, monospace" VerticalAlignment="Center"
                                     Command="{Binding $parent[TreeView].((vm:ObjectViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}"
                                     ToolTip.Tip="Open this object" />
                    <ctl:NoteText Text="{Binding Root}" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </StackPanel>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </DockPanel>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</UserControl>
