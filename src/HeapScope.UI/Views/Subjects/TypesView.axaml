<!-- The types grid of the selected snapshot (sprint 1.3): heap kinds, grouping, filter, retained and generation columns. Split from the Snapshot tab in sprint 2.4 (2.3.7 review M8). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HeapScope.UI.ViewModels"
             xmlns:ctl="using:HeapScope.UI.Controls"
             xmlns:dto="using:HeapScope.Contracts"
             x:Class="HeapScope.UI.Views.Subjects.TypesView"
             x:DataType="vm:TypeSummaryViewModel">
  <DockPanel>
    <!-- Heap kinds: one fixed color per kind, width by share of the bytes. -->
    <StackPanel DockPanel.Dock="Top" Margin="0,0,8,8">
      <ItemsControl ItemsSource="{Binding HeapKinds}" Height="10">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <ctl:ProportionalPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:HeapKindShare">
            <Border ctl:ProportionalPanel.Weight="{Binding Fraction}" ToolTip.Tip="{Binding Text}"
                    ctl:ThemeBrush.Background="{Binding BrushKey}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <DockPanel Margin="0,4,0,0">
      <ctl:InfoIcon Text="{x:Static vm:InfoTexts.HeapAreas}" DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Top" />
      <ItemsControl ItemsSource="{Binding HeapKinds}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:HeapKindShare">
            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
              <Border Width="10" Height="10" Margin="0,0,4,0" ctl:ThemeBrush.Background="{Binding BrushKey}" />
              <TextBlock Text="{Binding Text}" FontSize="11" Classes="subtle" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </DockPanel>
    </StackPanel>

    <WrapPanel DockPanel.Dock="Top" Margin="0,0,8,6">
      <TextBlock Text="Types" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0" />
      <ctl:InfoIcon Text="{Binding InfoText}" Margin="0,0,12,0" />
      <TextBlock Text="Group by" VerticalAlignment="Center" Margin="0,0,6,0" Classes="subtle" />
      <ComboBox Width="130" ItemsSource="{Binding Groupings}" SelectedItem="{Binding GroupBy, Mode=TwoWay}" VerticalAlignment="Center" />
      <TextBlock Text="Filter" VerticalAlignment="Center" Margin="16,0,6,0" Classes="subtle" />
      <TextBox x:Name="FilterBox" Width="260" Text="{Binding Filter, Mode=TwoWay}" VerticalAlignment="Center"
               ToolTip.Tip="Keeps rows whose name matches: terms separated by spaces must all match, and an all lower-case term ignores case. * matches anything, -term leaves out matches, module:name or m:name matches the module, and capitals also match word starts, so SCE finds StaticCacheEntry. Ctrl+F (Cmd+F on macOS) comes here." />
      <CheckBox Content="Generations" Margin="16,0,0,0" VerticalAlignment="Center"
                IsChecked="{Binding ShowGenerations, Mode=TwoWay}" IsEnabled="{Binding HasGenerations}" />
      <CheckBox Content="Retained sizes" Margin="16,0,0,0" VerticalAlignment="Center" IsVisible="{Binding !IsSet}"
                IsChecked="{Binding ShowRetained, Mode=TwoWay}" />
      <Button Content="Unreachable objects" Margin="16,0,0,0" VerticalAlignment="Center" IsVisible="{Binding CanOpenUnreachable}"
              Command="{Binding OpenUnreachableCommand}" />
      <ctl:InfoIcon Text="{Binding OptionsInfoText}" Margin="12,0,0,0" VerticalAlignment="Center" />
      <TextBlock Text="{Binding Totals}" VerticalAlignment="Center" Margin="12,0,0,0" Classes="subtle" TextTrimming="CharacterEllipsis" />
    </WrapPanel>
    <ctl:NoteText DockPanel.Dock="Top" Text="{Binding Status}" Margin="0,0,0,4" />
    <ctl:NoteText DockPanel.Dock="Top" Text="{Binding GroupNote}" Margin="0,0,0,4" TextWrapping="Wrap" Classes="subtle" />
    <ctl:NoteText DockPanel.Dock="Top" Text="{Binding GenerationsExplanation}" Margin="0,0,0,4" TextWrapping="Wrap" Classes="subtle" />
    <ctl:NoteText DockPanel.Dock="Top" Text="{Binding RetainedNote}" Margin="0,0,0,4" TextWrapping="Wrap" Classes="subtle" />

    <DataGrid x:Name="TypesGrid" ctl:GridExports.ExportName="Types" CanUserSortColumns="True" SelectionMode="Extended"
              ctl:GridBehaviors.Rows="{Binding Rows}"
              ctl:GridBehaviors.SortCommand="{Binding SortByCommand}" ctl:GridBehaviors.SortState="{Binding SortState}"
              ctl:GridBehaviors.OpenCommand="{Binding OpenRowCommand}"
              ctl:GridBehaviors.VisibleColumnGroups="{Binding VisibleColumnGroups}"
              ToolTip.Tip="Double-click or Enter opens a type's objects, or a namespace, assembly or interface as a set; Ctrl or Shift selects several types to open as one set (Ctrl+Shift+O); right-click for more.">
      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Open as a set" InputGesture="Ctrl+Shift+O" Command="{Binding OpenAsSetCommand}" CommandParameter="{Binding #TypesGrid.SelectedItems}" IsVisible="{Binding !IsSet}"
                    ToolTip.ShowOnDisabled="True" ToolTip.Tip="Treats the selected rows as one group of objects, with its own views. Takes up to 10,000 types, or one namespace, assembly or interface row." />
          <MenuItem Header="Show in dominator tree" Command="{Binding ShowInRetainersCommand}" CommandParameter="{Binding #TypesGrid.SelectedItem}" IsVisible="{Binding !IsSet}"
                    ToolTip.ShowOnDisabled="True" ToolTip.Tip="Opens the Retainers tab at this type's group, in the tree of what keeps what alive. Needs grouping by type; if no object of the type is at the top of the tree, it says so." />
          <MenuItem Header="{x:Static dto:ValueBoundTexts.SetAction}" Command="{Binding RetainedBySetCommand}" CommandParameter="{Binding #TypesGrid.SelectedItem}" IsVisible="{Binding !IsSet}"
                    ToolTip.ShowOnDisabled="True" ToolTip.Tip="Computes exactly what this type's objects keep alive together, on the Retainers tab; needs grouping by type. It can be more than the Retained column, which leaves out what several of them hold together." />
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Name" Width="*" MinWidth="240" SortMemberPath="Name">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:TypeRowItem">
              <TextBlock Margin="4,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"
                         ctl:HighlightedText.Filter="{Binding $parent[DataGrid].((vm:TypeSummaryViewModel)DataContext).Filter}"
                         ctl:HighlightedText.Text="{Binding Name}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Objects" x:DataType="vm:TypeRowItem" Binding="{Binding Objects, StringFormat='{}{0:N0}'}" Width="100" SortMemberPath="Objects" CellStyleClasses="number" />
        <DataGridTextColumn Header="Bytes" x:DataType="vm:TypeRowItem" Binding="{Binding Bytes, StringFormat='{}{0:N0}'}" Width="130" SortMemberPath="Bytes" CellStyleClasses="number" />
        <DataGridTextColumn Header="%" x:DataType="vm:TypeRowItem" Binding="{Binding Percent, StringFormat='{}{0:N1}'}" Width="60" CanUserSort="False" CellStyleClasses="number" />
        <DataGridTextColumn Header="Retained" x:DataType="vm:TypeRowItem" Binding="{Binding Retained, StringFormat='{}{0:N0}'}" Width="130" SortMemberPath="Retained" CellStyleClasses="number" Tag="Retained" IsVisible="False" />
        <DataGridTextColumn Header="Gen0" x:DataType="vm:TypeRowItem" Binding="{Binding Gen0, StringFormat='{}{0:N0}'}" Width="110" CanUserSort="False" CellStyleClasses="number" Tag="Generations" IsVisible="False" />
        <DataGridTextColumn Header="Gen1" x:DataType="vm:TypeRowItem" Binding="{Binding Gen1, StringFormat='{}{0:N0}'}" Width="110" CanUserSort="False" CellStyleClasses="number" Tag="Generations" IsVisible="False" />
        <DataGridTextColumn Header="Gen2" x:DataType="vm:TypeRowItem" Binding="{Binding Gen2, StringFormat='{}{0:N0}'}" Width="110" CanUserSort="False" CellStyleClasses="number" Tag="Generations" IsVisible="False" />
        <DataGridTextColumn Header="LOH" x:DataType="vm:TypeRowItem" Binding="{Binding LargeObjectHeap, StringFormat='{}{0:N0}'}" Width="110" CanUserSort="False" CellStyleClasses="number" Tag="Generations" IsVisible="False" />
        <DataGridTextColumn Header="POH" x:DataType="vm:TypeRowItem" Binding="{Binding PinnedObjectHeap, StringFormat='{}{0:N0}'}" Width="90" CanUserSort="False" CellStyleClasses="number" Tag="Generations" IsVisible="False" />
        <DataGridTextColumn Header="Frozen" x:DataType="vm:TypeRowItem" Binding="{Binding Frozen, StringFormat='{}{0:N0}'}" Width="90" CanUserSort="False" CellStyleClasses="number" Tag="Generations" IsVisible="False" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
