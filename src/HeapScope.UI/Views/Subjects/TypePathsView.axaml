<!-- Why a type's objects are alive: its key retention paths (sprint 2.2). Split from the Snapshot tab in sprint 2.4 (2.3.7 review M8). A set's Paths view and the diagram since 3.2. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HeapScope.UI.ViewModels"
             xmlns:ctl="using:HeapScope.UI.Controls"
             x:Class="HeapScope.UI.Views.Subjects.TypePathsView"
             x:DataType="vm:TypePathsViewModel">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,8,6">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Button Content="Similar retention" Command="{Binding SimilarRetentionCommand}" IsVisible="{Binding !IsSet}"
                ToolTip.Tip="Groups the objects by how they are retained, each group with its most different paths." />
        <CheckBox x:Name="DiagramToggle" Content="Diagram" IsChecked="{Binding ShowDiagram, Mode=TwoWay}" VerticalAlignment="Center"
                  ToolTip.Tip="The paths merged into one graph: roots at the top, the objects at the bottom." />
        <CheckBox Content="Show framework steps" IsChecked="{Binding ShowFramework, Mode=TwoWay}" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Text="{Binding Totals}" TextWrapping="Wrap" Classes="subtle" />
    </DockPanel>
    <ctl:NoteText DockPanel.Dock="Top" Text="{Binding Status}" Margin="0,0,0,4" TextWrapping="Wrap" />
    <ScrollViewer IsVisible="{Binding ShowDiagram}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <ctl:KeyPathDiagramView x:Name="PathsDiagram" Diagram="{Binding Diagram}" AutomationProperties.Name="Key retention paths diagram" />
    </ScrollViewer>
    <DataGrid x:Name="TypePathsGrid" IsVisible="{Binding !ShowDiagram}" ctl:GridExports.ExportName="RetentionPaths" ItemsSource="{Binding Paths}" CanUserSortColumns="False"
              ctl:GridBehaviors.OpenCommand="{Binding OpenRowCommand}"
              ToolTip.Tip="Double-click or Enter opens an example object kept alive this way.">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Objects" x:DataType="vm:KeyPathItem" Binding="{Binding Objects, StringFormat='{}{0:N0}'}" Width="100" CellStyleClasses="number" />
        <DataGridTextColumn Header="Bytes" x:DataType="vm:KeyPathItem" Binding="{Binding Bytes, StringFormat='{}{0:N0}'}" Width="120" CellStyleClasses="number" />
        <DataGridTextColumn Header="Root" x:DataType="vm:KeyPathItem" Binding="{Binding Root}" Width="*" />
        <DataGridTextColumn Header="Path from the root" x:DataType="vm:KeyPathItem" Binding="{Binding PathText}" Width="2*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
