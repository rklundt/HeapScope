<!-- Why a type's objects are alive: its key retention paths (sprint 2.2). Split from the Snapshot tab in sprint 2.4 (2.3.7 review M8). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HeapScope.UI.ViewModels"
             xmlns:ctl="using:HeapScope.UI.Controls"
             x:Class="HeapScope.UI.Views.Subjects.TypePathsView"
             x:DataType="vm:TypePathsViewModel">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,8,6">
      <CheckBox DockPanel.Dock="Right" Content="Show framework steps" IsChecked="{Binding ShowFramework, Mode=TwoWay}" VerticalAlignment="Center" />
      <TextBlock Text="{Binding Totals}" TextWrapping="Wrap" Classes="subtle" />
    </DockPanel>
    <ctl:NoteText DockPanel.Dock="Top" Text="{Binding Status}" Margin="0,0,0,4" TextWrapping="Wrap" />
    <DataGrid x:Name="TypePathsGrid" ctl:GridExports.ExportName="RetentionPaths" ItemsSource="{Binding Paths}" CanUserSortColumns="False"
              ctl:GridBehaviors.OpenCommand="{Binding OpenRowCommand}"
              ToolTip.Tip="Double-click or Enter opens an example object kept alive this way.">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Objects" x:DataType="vm:KeyPathItem" Binding="{Binding Objects, StringFormat='{}{0:N0}'}" Width="100" CellStyleClasses="number" />
        <DataGridTextColumn Header="Bytes" x:DataType="vm:KeyPathItem" Binding="{Binding Bytes, StringFormat='{}{0:N0}'}" Width="120" CellStyleClasses="number" />
        <DataGridTextColumn Header="Root" x:DataType="vm:KeyPathItem" Binding="{Binding Root}" Width="*" />
        <DataGridTextColumn Header="Path from the root" x:DataType="vm:KeyPathItem" Binding="{Binding PathText}" Width="2*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
