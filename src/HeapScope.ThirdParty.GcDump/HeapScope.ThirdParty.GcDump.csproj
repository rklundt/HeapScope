<Project Sdk="Microsoft.NET.Sdk">
  <!-- Vendored MIT code from dotnet/diagnostics (PerfView's gcdump reader and writer); see README.md and
       THIRD-PARTY-NOTICES.md. Built as it is: no nullable context, no analyzers, unsafe code allowed. -->
  <PropertyGroup>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <RunAnalyzers>false</RunAnalyzers>
    <AnalysisLevel>none</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" />
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" />
  </ItemGroup>
</Project>
